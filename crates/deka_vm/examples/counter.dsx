export fn Counter() {
    let count = 0;

    return (
        <view class="p-6 gap-4 bg-[#F3EFE3] text-[#1A1611]">
            <p class="text-2xl">Deka native VM</p>
            <p>DekaScript markup, state and handlers. Rust draws the window.</p>
            <p class="text-2xl">Count: {count}</p>
            <div class="flex-row gap-3">
                <button onClick={fn() { count += 1; }}>Add one</button>
                <button onClick={fn() { count = 0; }}>Reset</button>
            </div>
        </view>
    );
}
