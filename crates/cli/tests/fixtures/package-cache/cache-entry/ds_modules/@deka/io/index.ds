// Program output. User DekaScript imports `echo`; it must not name `console`.
//
// No `bridge`, no `unsafe`: the closed `deka.*` catalog is the one door for
// platform operations the runtime owns (RFD 21). `deka.io.echo` is classified
// Safe — it cannot throw — so there is no failure path to catch and no
// fallback value to fabricate. This package is the only place that may name
// the operation (RFD 21 / RFD 32).

/// docid: phpx/io/echo()
/// <Function name="echo">
///   <Description>Write one line of program output. Trailing newline comes from the host `console.log`.</Description>
///   <Parameter name="message" type="string" required="true" typeLink="/docs/php/types/string">
///     Line to write. Non-strings: caller stringifies, e.g. `echo("" + n)`.
///   </Parameter>
///   <ReturnType type="void" />
/// </Function>
export fn echo(message: string) {
  safe { deka.io.echo(message) }
}
