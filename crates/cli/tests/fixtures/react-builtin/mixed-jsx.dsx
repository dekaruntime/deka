import { jsx, jsx as makeElement } from "@js/react/jsx-runtime"

export fn manualJsx() ReactNode {
  return jsx("p", { children: "manual jsx" }, "manual-key")
}

export fn literalJsx() ReactNode {
  return <section>literal jsx</section>
}

export fn aliasedJsx() ReactNode {
  return makeElement("aside", { children: "aliased jsx" })
}
