import { ThemeToggle } from "../src/ui/Theme.dsx"
import { NewsletterSignup } from "../src/ui/Newsletter.dsx"

interface LayoutProps {
  children: ReactNode
}

export fn Layout(props: LayoutProps) ReactNode {
  return (
    <div>
      <header>
        <ThemeToggle client:load />
      </header>
      <main>{props.children}</main>
      <footer>
        <NewsletterSignup client:load />
      </footer>
    </div>
  )
}
