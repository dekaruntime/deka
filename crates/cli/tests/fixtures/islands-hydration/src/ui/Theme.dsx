export fn ThemeToggle() ReactNode {
  const pair = useState("light")
  const theme = pair[0]
  const setTheme = pair[1]
  useEffect(fn() Option<fn() void> {
    const _ = unsafe {
      var root = globalThis.document && globalThis.document.documentElement
      if (root) {
        root.setAttribute("data-theme", theme)
      }
      return 1
    }
    return None
  })
  let label = "Dark"
  if (theme == "dark") {
    label = "Light"
  }
  return (
    <button type="button" id="theme-toggle" class="theme-toggle" data-theme={theme} onClick={fn() void {
      if (theme == "dark") {
        setTheme("light")
      } else {
        setTheme("dark")
      }
    }}>{label}</button>
  )
}
