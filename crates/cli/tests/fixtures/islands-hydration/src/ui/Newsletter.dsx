opaque type Any

export fn NewsletterSignup() ReactNode {
  const emailPair = useState("")
  const sentPair = useState(false)
  const email = emailPair[0]
  const setEmail = emailPair[1]
  const sent = sentPair[0]
  const setSent = sentPair[1]
  let status = "No tracking pixels. This form stays on the page."
  if (sent == true) {
    status = "Thanks — we will not actually email " + email + "."
  }
  return <form class="nl-form" id="newsletter" onSubmit={fn(event: Any) void {
      const _ = unsafe {
        event.preventDefault()
        return 1
      }
      const value = match (unsafe<string> { return event.target.elements.email.value }) {
        Ok(v) => v,
        Err(_) => email
      }
      setEmail(value)
      setSent(true)
    }}>
      <input id="nl-email" class="nl-input" type="email" name="email" placeholder="you@example.com" />
      <button class="nl-btn" type="submit" id="nl-submit">Subscribe</button>
      <p class="nl-status" id="nl-status">{status}</p>
    </form>
}
