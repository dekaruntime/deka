import { Counter } from "./Counter.dsx"

fn greeting(name: string) string {
  return "Hello, " + name + "."
}

export fn Page() ReactNode {
  return (
    <main class="page">
      <section class="hero">
        <svg class="logo" viewBox="0 0 100 100" role="img" aria-label="deka">
          <circle cx="50" cy="50" r="49" fill="#FED201" />
          <path d="M50,1 A49,49 0 0 1 50,99 A24.5,24.5 0 0 1 50,50 A24.5,24.5 0 0 0 50,1 Z" fill="#6347AE" stroke="#fff" stroke-width="3" />
        </svg>
        <h1>Deka App</h1>
        <p>{greeting("World")}</p>
        <Counter client:load />
        <p class="hint">Get started by editing <code>app/page.dsx</code></p>
        <p class="hint">Save and see your changes right away</p>
      </section>
      <footer class="footer">
        <a href="https://deka.gg/docs">Docs</a>
        <a href="https://deka.gg/tour">Language Tour</a>
        <a href="https://deka.gg/discord">Discord</a>
        <a href="https://github.com/dekaruntime/deka">GitHub</a>
      </footer>
    </main>)
}
