import { echo } from "io"

// `Promise<T>` is still a type -- it resolves through the type system, not
// through the ambient globals that deka#378 removed. What is gone is reaching
// the `Promise` *object* in plain code, so `Promise.resolve` moves to `unsafe`.
async fn value() Promise<number> {
  return 1
}

async fn indirect() Promise<number> {
  let resolved = unsafe<Promise<number>> { Promise.resolve(2) }
  return match (resolved) {
    Ok(pending) => await pending,
    Err(_) => 0,
  }
}

async fn main() {
  echo(string(await value()))
  echo(string(await indirect()))
}

await main()
