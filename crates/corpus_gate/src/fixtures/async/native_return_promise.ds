import { echo } from "io"
import { assert } from "test"

// Native async functions construct typed promises without a JavaScript host.
async fn value() Promise<number> {
  return 1
}

async fn pending() Promise<number> {
  return 2
}

async fn indirect(fail: boolean) Promise<number> {
  const resolved: Result<Promise<number>, string> = fail ? Err("failed") : Ok(pending())
  return match (resolved) {
    Ok(promise) => await promise,
    Err(_) => 0,
  }
}

async fn main() {
  echo(string(await value()))
  echo(string(await indirect(false)))
  assert(await indirect(true) == 0)
}

await main()
