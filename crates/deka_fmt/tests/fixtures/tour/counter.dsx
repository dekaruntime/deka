export fn App() {
    let count = 0;

    return (
        <view class="flex flex-col gap-4 p-6 bg-[#F3EFE3] text-[#1A1611]">
            <span class="text-2xl">Deka, native.</span>
            <span>The same UI, inside your browser.</span>
            <div class="flex flex-row gap-4">
                <button class="p-4 rounded-lg bg-[#0C8B43] text-[#ffffff]"
                    onClick={fn() { count = count + 1; }}>
                    Add one
                </button>
                <button class="p-4 rounded-lg bg-[#5946AD] text-[#ffffff]"
                    onClick={fn() { count = count - 1; }}>
                    Subtract one
                </button>
            </div>
            <span class="text-xl">Count: {count}</span>
        </view>
    );
}
