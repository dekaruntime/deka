export fn App() {
    let open = 0;
    return (
        <view class="w-full h-full p-4 gap-4 bg-[#F3EFE3]">
            <button class="w-48 bg-[#663399] text-[#ffffff]" onClick={fn() {open = 1 - open;}}>Toggle spring motion</button>
            <span>Click again while it moves to reverse the spring.</span>
            <div class="w-full h-64 p-8 gap-3 overflow-hidden">
                <div class={open == 1 ? "w-20 h-20 rounded-lg bg-[#663399] translate-x-48 transition-transform spring spring-damping-9" : "w-20 h-20 rounded-lg bg-[#663399] translate-x-0 transition-transform spring spring-damping-9"} />
            </div>
        </view>
    );
}
