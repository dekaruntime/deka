export fn App() {
    let open = 0;
    return (
        <view class="w-full h-full p-4 gap-4 bg-[#F3EFE3]">
            <button class="w-48 bg-[#663399] text-[#ffffff]" onClick={fn() {open = 1 - open;}}>Toggle staggered entrance</button>
            <span>A parent spaces its children's entrances by 120ms.</span>
            <div class="w-full h-64 p-8 gap-3 overflow-hidden">
                {open == 1 ? <div class="w-64 gap-3 stagger-120"><div class="p-3 bg-[#663399] text-[#ffffff] enter-slide exit-fade duration-400">Projects</div><div class="p-3 bg-[#663399] text-[#ffffff] enter-slide duration-400">Activity</div><div class="p-3 bg-[#663399] text-[#ffffff] enter-slide duration-400">Settings</div></div> : None}
            </div>
        </view>
    );
}
