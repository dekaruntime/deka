export fn App() {
    const apples = 8;
    const pears = 4;

    return (
        <view>
            <p>Total fruit: {apples + pears}</p>
            <p>Apples left after eating two: {apples - 2}</p>
            <p>Twice as many pears: {pears * 2}</p>
            <p>Apples per person, shared by two: {apples / 2}</p>
        </view>
    );
}
