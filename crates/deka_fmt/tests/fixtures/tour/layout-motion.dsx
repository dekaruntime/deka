export fn App() {
    let open = 0;
    return (
        <view class="w-full h-full p-4 gap-4 bg-[#F3EFE3]">
            <button class="w-48 bg-[#663399] text-[#ffffff]" onClick={fn() {open = 1 - open;}}>Toggle layout movement</button>
            <span>Changing alignment gives the box a new layout destination.</span>
            <div class="w-full h-64 p-8 gap-3 overflow-hidden">
                <div class={open == 1 ? "w-full h-28 flex-row justify-end bg-[#E2DCCF]" : "w-full h-28 flex-row justify-start bg-[#E2DCCF]"}><div class="w-20 h-20 shrink-0 rounded-lg bg-[#0C8B43] transition-layout spring" /></div>
            </div>
        </view>
    );
}
