export fn App() {
    const projects = ["Deka", "Zega", "My next idea"];
    let selected = "Choose a project";
    return (
        <view class="p-6 gap-3 bg-[#F3EFE3] text-[#1A1611]">
            <p class="text-xl">{selected}</p>
            {projects.map(fn(name: string) {
                return (<button class={selected == name ? "p-3 bg-[#0C8B43] text-[#ffffff]" : "p-3 bg-[#E2DCCF]"}
                    onClick={fn() { selected = name; }}>{name}</button>);
            })}
        </view>
    );
}
