fn twice(value: number) number {
    return value * 2;
}

export fn App() {
    let value = 3;
    return (
        <view className="p-6 gap-3 bg-[#F3EFE3] text-[#1A1611]">
            <p className="text-xl">Functions calculate values</p>
            <p>Input: {value}</p>
            <p>Doubled: {twice(value)}</p>
            <button onClick={fn() { value += 1; }}>Next number</button>
        </view>
    );
}
