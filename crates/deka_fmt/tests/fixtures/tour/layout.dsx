export fn App() {
    let count = 0;
    return (
        <view class="w-full h-full p-4 gap-3 bg-[#F3EFE3] text-[#1A1611]">
            <span class="text-xl">Boxes and text</span>
            <div class="w-full h-24 flex-row items-center justify-between px-4 bg-[#E2DCCF] shrink-0">
                <div class="w-12 h-12 bg-[#663399] rounded" />
                <div class="w-20 h-8 bg-[#0C8B43] rounded" />
            </div>
            <div class="w-full flex-row flex-wrap gap-2">
                <button class="w-24 h-10 p-2 shrink-0 bg-[#663399] text-[#ffffff]"
                    onClick={fn() { count = count + 1; }}>Count: {count}</button>
                <span class="w-40">Resize the preview. These words wrap inside their box.</span>
            </div>
            <div class="w-40 h-8 overflow-hidden shrink-0 bg-[#E2DCCF]">
                <span class="w-80 whitespace-nowrap">This text extends past the clipping boundary.</span>
            </div>
        </view>
    );
}
