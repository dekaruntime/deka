export fn App() {
    let visible = 0;
    return (
        <view class="w-full h-full p-4 gap-3 bg-[#F3EFE3]">
            <button class="w-40 bg-[#663399] text-[#ffffff]" onClick={fn() { visible = 1 - visible; }}>Toggle toast</button>
            <div class="w-full h-52 overflow-hidden justify-end items-end bg-[#E2DCCF]">
                <div class={visible == 1 ? "w-64 p-4 gap-2 rounded-lg bg-[#0C8B43] text-[#ffffff] opacity-100 translate-y-0 transition-all duration-500 ease-out" : "w-64 p-4 gap-2 rounded-lg bg-[#0C8B43] text-[#ffffff] opacity-0 translate-y-24 transition-all duration-500 ease-out"}>
                    <span class="text-xl">Changes saved</span>
                    <span>A little motion makes the message easy to notice.</span>
                </div>
            </div>
        </view>
    );
}
