# Deka Website - Environment Configuration
#
# Copy this file to .env.local for local development
#

# Deka Identity Service (for authentication)
# Local development: http://localhost:8524
# Production: https://id.deka.gg
NEXT_PUBLIC_IDENTITY_URL=http://localhost:8524

# Website URL (for OAuth callbacks)
# Local development: http://localhost:3000
# Production: https://deka.gg
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000

# Legacy Tana API (if needed)
# NEXT_PUBLIC_API_URL=https://api-testnet.tana.network

# Tana SSO (NextAuth)
# Base URL of the Tana identity provider
SSO_IDP_URL=https://id.tana.gg
# Client secret shared with the Tana IdP. Production deka.gg must set
# SSO_SECRET_DEKA because the id.tana.gg :Service hmac_secret_ref uses that name.
SSO_SECRET_DEKA=
# Backward-compatible local fallback for older developer envs.
# SSO_CLIENT_SECRET=
# NextAuth secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=
# NextAuth URL (must match the site origin for callbacks)
NEXTAUTH_URL=http://localhost:3000
