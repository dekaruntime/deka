// PayPal provider — stub.
//
// PayPal is **deferred post-launch** per the meta comment on #92 — MVP
// ships Stripe + Square only. We still ship this stub so the @deka/payments
// module graph is stable: when PayPal gets wired up later (Commerce Partner
// Referrals API), it's a single module swap with no import churn for
// callers.
//
// Every method returns Err('not_implemented').

export function paypal_name() {
  return 'paypal'
}

