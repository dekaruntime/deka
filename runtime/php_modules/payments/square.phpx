import { result_ok, result_err, result_is_ok } from 'core/result'
import { hmac_sha256_hex, secure_compare, random_bytes_result } from 'crypto'
import { json_encode, json_decode } from 'encoding/json'
import { now_ms } from 'time'

import { validate_return_url } from './return_url.phpx'
import { oauth_state_issue, oauth_state_consume } from './oauth_state.phpx'
import { authorize_refund, require_refund_reason, log_refund_attempt } from './refund_auth.phpx'
import { token_vault_encrypt, token_vault_decrypt } from './token_vault.phpx'
import { new_connected_account, new_charge, new_refund, new_event, new_account_status } from './types.phpx'

// @deka/payments/square — Square OAuth 2.0 integration (issue #96).
//
// Unlike Stripe Connect Express (which hands us a platform-owned Express
// Account id), Square uses full OAuth 2.0: we exchange an auth code for
// an access_token + refresh_token pair that's tied to the merchant's
// Square account. Those tokens are the only way to charge on their
// behalf, so they're sensitive — we keep them encrypted at rest via the
// token_vault (AES-256-GCM, per-record nonce, shop_id AAD binding).
//
// Callers (store-admin routes) pass a pluggable `$http` transport. Tests
// inject a mock; production wraps a bridge HTTP call. Contract is the
// same as stripe.phpx — see that module for the full request/response
// shape.
//
// Security baseline (see issues #118, #119, #120, #123):
//   - #118 — OAuth state: Redis-backed, 10-minute TTL, one-time-use.
//     Bound to the caller's shop_id and session jti. The `state` value
//     is also what carries CSRF protection through Square's auth page.
//   - #119 — Token encryption at rest: every access_token + refresh_token
//     passes through `token_vault_encrypt()` before it touches storage.
//     Versioned blob (v1:{keyid}:{nonce}:{ct+tag}). Decrypt tries primary
//     + v2 keys so rotation doesn't lock out live merchants. See the
//     comment block at the top of token_vault.phpx for the rotation
//     procedure and compromise playbook.
//   - #120 — return_url allowlist: `validate_return_url()` runs before
//     any Square API hit. Invalid URL → `square:invalid_return_url`.
//   - #123 — refund authorization: `square_refund()` demands an actor
//     with a privileged role, a non-empty reason, and writes a
//     RefundAudit entry for every attempt (success or failure).
//
// Env vars (read from $_ENV):
//   SQUARE_APPLICATION_ID          — sq0idp-* or sandbox-sq0idb-*
//   SQUARE_APPLICATION_SECRET      — OAuth client secret
//   SQUARE_WEBHOOK_SIGNATURE_KEY   — v2 webhook HMAC key
//   SQUARE_TOKEN_ENCRYPTION_KEY    — primary token-vault key
//   SQUARE_TOKEN_ENCRYPTION_KEY_V2 — optional rotation key

const SQUARE_API_BASE_PROD = 'https://connect.squareup.com'
const SQUARE_API_BASE_SANDBOX = 'https://connect.squareupsandbox.com'
const SQUARE_OAUTH_SCOPES = 'PAYMENTS_WRITE PAYMENTS_READ ITEMS_READ ORDERS_WRITE ORDERS_READ MERCHANT_PROFILE_READ'
const SQUARE_API_VERSION = '2024-06-04'

// ---------------------------------------------------------------------------
// Public surface
// ---------------------------------------------------------------------------

export function square_name() {
  return 'square'
}

/// docid: phpx/payments/square_connect_url()
/// <Function name="square_connect_url">
///   <Description>Start Square OAuth 2.0 onboarding. Validates return_url, issues a Redis-backed state, returns the hosted authorize URL.</Description>
///   <ReturnType type="mixed" />
/// </Function>
export function square_connect_url($return_url, $shop_id, $session_jti = '') {
  $url_check = validate_return_url($return_url)
  if (!result_is_ok($url_check)) {
    return result_err('square:invalid_return_url')
  }
  $clean_return = $url_check->value

  if (!is_string($shop_id) || strlen($shop_id) === 0) {
    return result_err('square:missing_shop_id')
  }

  $app_id = env_get('SQUARE_APPLICATION_ID')
  if (strlen($app_id) === 0) {
    return result_err('square:missing_application_id')
  }

  $jti = is_string($session_jti) && strlen($session_jti) > 0 ? $session_jti : ('system-' . $shop_id)
  $state_res = oauth_state_issue($shop_id, 'square', $jti)
  if (!result_is_ok($state_res)) {
    return result_err('square:state_issue_failed')
  }
  $state = $state_res->value

  $base = is_sandbox_app_id($app_id) ? SQUARE_API_BASE_SANDBOX : SQUARE_API_BASE_PROD
  $authorize = $base . '/oauth2/authorize'
    . '?client_id=' . urlencode($app_id)
    . '&scope=' . urlencode(SQUARE_OAUTH_SCOPES)
    . '&session=false'
    . '&state=' . urlencode($state)

  return result_ok({
    url: $authorize,
    state: $state,
    return_url: $clean_return,
  })
}

/// docid: phpx/payments/square_handle_callback()
/// <Function name="square_handle_callback">
///   <Description>Complete the Square OAuth flow: verify state, exchange the auth code for access+refresh tokens, encrypt them, return a ConnectedAccount. Caller persists the ConnectedAccount + the ciphertext blobs.</Description>
///   <ReturnType type="mixed" />
/// </Function>
export function square_handle_callback($query, $expected_shop_id, $expected_jti, $http = false) {
  $state = pick_query($query, 'state')
  if (strlen($state) === 0) {
    return result_err('square:missing_state')
  }
  $code = pick_query($query, 'code')
  if (strlen($code) === 0) {
    return result_err('square:missing_code')
  }

  $consume = oauth_state_consume($state, $expected_shop_id, 'square', $expected_jti)
  if (!result_is_ok($consume)) {
    return result_err('square:invalid_state')
  }

  $app_id = env_get('SQUARE_APPLICATION_ID')
  $app_secret = env_get('SQUARE_APPLICATION_SECRET')
  if (strlen($app_id) === 0 || strlen($app_secret) === 0) {
    return result_err('square:missing_oauth_credentials')
  }

  $base = is_sandbox_app_id($app_id) ? SQUARE_API_BASE_SANDBOX : SQUARE_API_BASE_PROD
  $body = json_encode({
    client_id: $app_id,
    client_secret: $app_secret,
    code: $code,
    grant_type: 'authorization_code',
  })
  $req = {
    method: 'POST',
    url: $base . '/oauth2/token',
    headers: square_json_headers(''),
    body: $body,
  }
  $res = http_call($http, $req)
  if (!result_is_ok($res)) {
    return $res
  }
  $tok = $res->value
  $access = pick_string($tok, 'access_token')
  $refresh = pick_string($tok, 'refresh_token')
  $merchant_id = pick_string($tok, 'merchant_id')
  $expires_at = pick_string($tok, 'expires_at')
  if (strlen($access) === 0 || strlen($merchant_id) === 0) {
    return result_err('square:token_response_malformed')
  }

  // Encrypt at rest (#119). AAD binds to shop_id so a stolen blob can't
  // be re-homed to a different shop's row.
  $enc_access = token_vault_encrypt($access, $expected_shop_id)
  if (!result_is_ok($enc_access)) {
    return result_err('square:access_token_encrypt_failed')
  }
  $enc_refresh = ''
  if (strlen($refresh) > 0) {
    $r = token_vault_encrypt($refresh, $expected_shop_id)
    if (!result_is_ok($r)) {
      return result_err('square:refresh_token_encrypt_failed')
    }
    $enc_refresh = $r->value
  }

  return result_ok(new_connected_account(
    'square',
    $merchant_id,
    true,
    now_ms(),
    {
      encrypted_access_token: $enc_access->value,
      encrypted_refresh_token: $enc_refresh,
      token_expires_at: $expires_at,
    }
  ))
}

/// docid: phpx/payments/square_create_charge()
/// <Function name="square_create_charge">
///   <Description>Charge via POST /v2/payments with app_fee_money + source_id. Takes an already-decrypted access_token (caller responsibility — fetch from vault, call this, zero the plaintext).</Description>
///   <ReturnType type="mixed" />
/// </Function>
export function square_create_charge($account, $access_token, $source_id, $amount_cents, $currency, $platform_fee_cents, $idempotency_key, $location_id, $http = false) {
  $merchant_id = pick_string($account, 'account_id')
  if (strlen($merchant_id) === 0) {
    return result_err('square:missing_account_id')
  }
  if (!is_string($access_token) || strlen($access_token) === 0) {
    return result_err('square:missing_access_token')
  }
  if (!is_string($source_id) || strlen($source_id) === 0) {
    return result_err('square:missing_source_id')
  }
  $amt = (int) $amount_cents
  if ($amt <= 0) {
    return result_err('square:amount_invalid')
  }
  $fee = (int) $platform_fee_cents
  if ($fee < 0 || $fee > $amt) {
    return result_err('square:fee_invalid')
  }
  $cur = strtoupper('' . $currency)
  if (strlen($cur) === 0) {
    $cur = 'USD'
  }
  $idem = '' . $idempotency_key
  if (strlen($idem) === 0) {
    return result_err('square:idempotency_key_required')
  }
  if (!is_string($location_id) || strlen($location_id) === 0) {
    return result_err('square:missing_location_id')
  }

  $body = json_encode({
    source_id: $source_id,
    idempotency_key: $idem,
    amount_money: { amount: $amt, currency: $cur },
    app_fee_money: { amount: $fee, currency: $cur },
    location_id: $location_id,
    autocomplete: true,
  })

  $app_id = env_get('SQUARE_APPLICATION_ID')
  $base = is_sandbox_app_id($app_id) ? SQUARE_API_BASE_SANDBOX : SQUARE_API_BASE_PROD
  $req = {
    method: 'POST',
    url: $base . '/v2/payments',
    headers: square_json_headers($access_token),
    body: $body,
  }
  $res = http_call($http, $req)
  if (!result_is_ok($res)) {
    return $res
  }
  $data = $res->value
  $payment = []
  if (is_array($data) && array_key_exists('payment', $data) && is_array($data['payment'])) {
    $payment = $data['payment']
  }
  $id = pick_string($payment, 'id')
  if (strlen($id) === 0) {
    return result_err('square:payment_malformed')
  }
  $status = pick_string($payment, 'status')
  if (strlen($status) === 0) {
    $status = 'PENDING'
  }

  return result_ok(new_charge($id, 'square', $amt, $cur, $fee, strtolower($status)))
}

/// docid: phpx/payments/square_refund()
/// <Function name="square_refund">
///   <Description>Refund via POST /v2/refunds. Requires an authorized actor, a non-empty reason; writes a RefundAudit entry on every attempt.</Description>
///   <ReturnType type="mixed" />
/// </Function>
export function square_refund($account, $access_token, $charge_id, $amount_cents, $currency, $actor, $shop_id, $reason, $charge_amount_cents = 0, $http = false) {
  $reason_check = require_refund_reason($reason)
  if (!result_is_ok($reason_check)) {
    log_refund_attempt($shop_id, $actor, $charge_id, $amount_cents, '' . $reason, 'rejected', $reason_check->error)
    return result_err('square:' . $reason_check->error)
  }
  $clean_reason = $reason_check->value

  $auth_check = authorize_refund($actor, $shop_id, $amount_cents, $charge_amount_cents)
  if (!result_is_ok($auth_check)) {
    log_refund_attempt($shop_id, $actor, $charge_id, $amount_cents, $clean_reason, 'rejected', $auth_check->error)
    return result_err('square:' . $auth_check->error)
  }

  if (!is_string($access_token) || strlen($access_token) === 0) {
    log_refund_attempt($shop_id, $actor, $charge_id, $amount_cents, $clean_reason, 'rejected', 'missing_access_token')
    return result_err('square:missing_access_token')
  }
  $cid = '' . $charge_id
  if (strlen($cid) === 0) {
    log_refund_attempt($shop_id, $actor, $charge_id, $amount_cents, $clean_reason, 'rejected', 'missing_charge_id')
    return result_err('square:missing_charge_id')
  }
  $amt = (int) $amount_cents
  $cur = strtoupper('' . $currency)
  if (strlen($cur) === 0) {
    $cur = 'USD'
  }

  $nonce_res = random_bytes_result(12)
  $idem = 'refund-' . now_ms()
  if (result_is_ok($nonce_res)) {
    // Use the nonce bytes as hex to namespace idempotency per request.
    // Full uniqueness not needed — Square just wants a per-call string.
    $idem = 'refund-' . now_ms() . '-' . $charge_id
  }

  $body = json_encode({
    idempotency_key: $idem,
    amount_money: { amount: $amt, currency: $cur },
    payment_id: $cid,
    reason: $clean_reason,
  })

  $app_id = env_get('SQUARE_APPLICATION_ID')
  $base = is_sandbox_app_id($app_id) ? SQUARE_API_BASE_SANDBOX : SQUARE_API_BASE_PROD
  $req = {
    method: 'POST',
    url: $base . '/v2/refunds',
    headers: square_json_headers($access_token),
    body: $body,
  }
  $res = http_call($http, $req)
  if (!result_is_ok($res)) {
    log_refund_attempt($shop_id, $actor, $charge_id, $amount_cents, $clean_reason, 'failed', $res->error)
    return $res
  }
  $data = $res->value
  $refund = []
  if (is_array($data) && array_key_exists('refund', $data) && is_array($data['refund'])) {
    $refund = $data['refund']
  }
  $rid = pick_string($refund, 'id')
  if (strlen($rid) === 0) {
    log_refund_attempt($shop_id, $actor, $charge_id, $amount_cents, $clean_reason, 'failed', 'refund_malformed')
    return result_err('square:refund_malformed')
  }
  $status = pick_string($refund, 'status')
  if (strlen($status) === 0) {
    $status = 'PENDING'
  }

  log_refund_attempt($shop_id, $actor, $charge_id, $amount_cents, $clean_reason, 'success', '')
  return result_ok(new_refund($rid, 'square', $cid, $amt, strtolower($status)))
}

/// docid: phpx/payments/square_webhook_verify()
/// <Function name="square_webhook_verify">
///   <Description>Verify the x-square-hmacsha256-signature header. Square signs `{notification_url}{body}` with the webhook v2 signature key.</Description>
///   <ReturnType type="mixed" />
/// </Function>
export function square_webhook_verify($body, $signature_header, $secret, $notification_url = '') {
  if (!is_string($body) || !is_string($signature_header) || !is_string($secret)) {
    return result_err('square:invalid_signature_inputs')
  }
  if (strlen($signature_header) === 0 || strlen($secret) === 0) {
    return result_err('square:invalid_signature_inputs')
  }

  // Square v2 webhooks: the signed payload is `{notification_url}{body}`
  // where notification_url is the fully qualified URL that was registered
  // in the Square dashboard. Callers pass it in — if they don't, we fall
  // back to just the body (matches dev/test setups where the merchant
  // hasn't registered a URL yet).
  $signed = strlen($notification_url) > 0 ? ($notification_url . $body) : $body
  $expected_hex = hmac_sha256_hex($signed, $secret)
  if (!is_string($expected_hex) || strlen($expected_hex) === 0) {
    return result_err('square:hmac_compute_failed')
  }

  // Header is base64-encoded bytes; recompute our expected in the same
  // format and compare.
  $expected_b64 = hex_to_base64($expected_hex)
  if (!is_string($expected_b64)) {
    return result_err('square:hmac_encode_failed')
  }

  if (!secure_compare($expected_b64, '' . $signature_header)) {
    return result_err('square:signature_mismatch')
  }

  $decoded = json_decode($body, true)
  if (!is_array($decoded)) {
    return result_err('square:event_body_invalid_json')
  }
  $id = array_key_exists('event_id', $decoded) ? ('' . $decoded['event_id']) : ''
  $type = array_key_exists('type', $decoded) ? ('' . $decoded['type']) : ''
  $created = now_ms()
  if (array_key_exists('created_at', $decoded)) {
    // Square sends ISO timestamps; best-effort parse — fall back to now_ms.
    $ts = strtotime('' . $decoded['created_at'])
    if (is_int($ts) && $ts > 0) {
      $created = $ts * 1000
    }
  }
  $data = array_key_exists('data', $decoded) ? $decoded['data'] : []

  return result_ok(new_event($id, 'square', $type, $created, $data))
}

/// docid: phpx/payments/square_account_status()
/// <Function name="square_account_status">
///   <Description>Fetch the merchant record + confirm authorization still works. Returns Ok(AccountStatus).</Description>
///   <ReturnType type="mixed" />
/// </Function>
export function square_account_status($account, $access_token, $http = false) {
  $merchant_id = pick_string($account, 'account_id')
  if (strlen($merchant_id) === 0) {
    return result_err('square:missing_account_id')
  }
  if (!is_string($access_token) || strlen($access_token) === 0) {
    return result_err('square:missing_access_token')
  }

  $app_id = env_get('SQUARE_APPLICATION_ID')
  $base = is_sandbox_app_id($app_id) ? SQUARE_API_BASE_SANDBOX : SQUARE_API_BASE_PROD
  $req = {
    method: 'GET',
    url: $base . '/v2/merchants/' . urlencode($merchant_id),
    headers: square_json_headers($access_token),
    body: '',
  }
  $res = http_call($http, $req)
  if (!result_is_ok($res)) {
    // If Square rejects the token, mark charges_disabled with the cause.
    return result_ok(new_account_status('square', $merchant_id, false, $res->error, []))
  }
  $data = $res->value
  $status = pick_string($data, 'status')
  $charges_enabled = ($status === 'ACTIVE')
  return result_ok(new_account_status('square', $merchant_id, $charges_enabled, $charges_enabled ? '' : $status, []))
}

/// docid: phpx/payments/square_refresh_token()
/// <Function name="square_refresh_token">
///   <Description>Exchange a refresh_token for a fresh access_token. Returns Ok({access_token, refresh_token, expires_at}) — caller re-encrypts and persists.</Description>
///   <ReturnType type="mixed" />
/// </Function>
export function square_refresh_token($refresh_token, $http = false) {
  if (!is_string($refresh_token) || strlen($refresh_token) === 0) {
    return result_err('square:missing_refresh_token')
  }
  $app_id = env_get('SQUARE_APPLICATION_ID')
  $app_secret = env_get('SQUARE_APPLICATION_SECRET')
  if (strlen($app_id) === 0 || strlen($app_secret) === 0) {
    return result_err('square:missing_oauth_credentials')
  }
  $base = is_sandbox_app_id($app_id) ? SQUARE_API_BASE_SANDBOX : SQUARE_API_BASE_PROD
  $body = json_encode({
    client_id: $app_id,
    client_secret: $app_secret,
    grant_type: 'refresh_token',
    refresh_token: $refresh_token,
  })
  $req = {
    method: 'POST',
    url: $base . '/oauth2/token',
    headers: square_json_headers(''),
    body: $body,
  }
  $res = http_call($http, $req)
  if (!result_is_ok($res)) {
    return $res
  }
  $tok = $res->value
  $access = pick_string($tok, 'access_token')
  $new_refresh = pick_string($tok, 'refresh_token')
  $expires_at = pick_string($tok, 'expires_at')
  if (strlen($access) === 0) {
    return result_err('square:refresh_response_malformed')
  }
  return result_ok({
    access_token: $access,
    refresh_token: $new_refresh,
    expires_at: $expires_at,
  })
}

/// docid: phpx/payments/square_disconnect()
/// <Function name="square_disconnect">
///   <Description>Revoke the OAuth authorization. POST /oauth2/revoke with client credentials. After this, caller clears Shop.payment_account_id + encrypted blobs.</Description>
///   <ReturnType type="mixed" />
/// </Function>
export function square_disconnect($account, $access_token, $http = false) {
  $merchant_id = pick_string($account, 'account_id')
  if (strlen($merchant_id) === 0) {
    return result_err('square:missing_account_id')
  }
  if (!is_string($access_token) || strlen($access_token) === 0) {
    return result_err('square:missing_access_token')
  }
  $app_id = env_get('SQUARE_APPLICATION_ID')
  $app_secret = env_get('SQUARE_APPLICATION_SECRET')
  if (strlen($app_id) === 0 || strlen($app_secret) === 0) {
    return result_err('square:missing_oauth_credentials')
  }
  $base = is_sandbox_app_id($app_id) ? SQUARE_API_BASE_SANDBOX : SQUARE_API_BASE_PROD
  $body = json_encode({
    client_id: $app_id,
    access_token: $access_token,
    merchant_id: $merchant_id,
  })
  $headers = {
    Authorization: 'Client ' . $app_secret,
    'Content-Type': 'application/json',
    Accept: 'application/json',
    'Square-Version': SQUARE_API_VERSION,
  }
  $req = {
    method: 'POST',
    url: $base . '/oauth2/revoke',
    headers: $headers,
    body: $body,
  }
  $res = http_call($http, $req)
  if (!result_is_ok($res)) {
    return $res
  }
  return result_ok({
    merchant_id: $merchant_id,
    disconnected: true,
  })
}

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

function square_json_headers($access_token) {
  $h = {
    'Content-Type': 'application/json',
    Accept: 'application/json',
    'Square-Version': SQUARE_API_VERSION,
  }
  if (is_string($access_token) && strlen($access_token) > 0) {
    $h['Authorization'] = 'Bearer ' . $access_token
  }
  return $h
}

function is_sandbox_app_id($app_id) {
  $s = '' . $app_id
  return strpos($s, 'sandbox-') === 0 || strpos($s, 'sq0idb-') === 0
}

function http_call($http, $request) {
  if (!is_callable($http)) {
    return result_err('square:no_http_transport')
  }
  $resp = $http($request)
  if (!is_array($resp) && !is_object($resp)) {
    return result_err('square:transport_returned_nothing')
  }
  $ok = is_array($resp) ? (array_key_exists('ok', $resp) && $resp['ok'] === true) : (isset($resp->ok) && $resp->ok === true)
  if (!$ok) {
    $err = 'square:http_failed'
    if (is_array($resp) && array_key_exists('error', $resp)) {
      $err = 'square:http_failed:' . $resp['error']
    } else if (is_object($resp) && isset($resp->error)) {
      $err = 'square:http_failed:' . $resp->error
    }
    return result_err($err)
  }
  $status = is_array($resp) ? (int) $resp['status'] : (int) $resp->status
  $body = is_array($resp) ? ('' . $resp['body']) : ('' . $resp->body)

  $decoded = json_decode($body, true)
  if (!is_array($decoded)) {
    $decoded = []
  }
  if ($status < 200 || $status >= 300) {
    $code = ''
    if (array_key_exists('errors', $decoded) && is_array($decoded['errors']) && count($decoded['errors']) > 0) {
      $first = $decoded['errors'][0]
      if (is_array($first) && array_key_exists('code', $first)) {
        $code = '' . $first['code']
      }
    }
    return result_err('square:api_error:' . ($status) . ':' . $code)
  }
  return result_ok($decoded)
}

function pick_string($obj, $key) {
  if (is_array($obj) && array_key_exists($key, $obj)) {
    $v = $obj[$key]
    if (!isset($v) || $v === false) {
      return ''
    }
    return '' . $v
  }
  if (is_object($obj) && isset($obj->$key)) {
    $v = $obj->$key
    if (!isset($v) || $v === false) {
      return ''
    }
    return '' . $v
  }
  return ''
}

function pick_query($query, $key) {
  if (is_array($query) && array_key_exists($key, $query)) {
    $v = $query[$key]
    if (!isset($v) || $v === false) {
      return ''
    }
    return '' . $v
  }
  if (is_object($query) && isset($query->$key)) {
    $v = $query->$key
    if (!isset($v) || $v === false) {
      return ''
    }
    return '' . $v
  }
  return ''
}

function env_get($name) {
  if (is_array($_ENV) && array_key_exists($name, $_ENV)) {
    $v = $_ENV[$name]
    if (!isset($v) || $v === false) {
      return ''
    }
    return '' . $v
  }
  if (is_array($_SERVER) && array_key_exists($name, $_SERVER)) {
    $v = $_SERVER[$name]
    if (!isset($v) || $v === false) {
      return ''
    }
    return '' . $v
  }
  return ''
}

function hex_to_base64($hex) {
  $h = '' . $hex
  $len = strlen($h)
  if ($len % 2 !== 0) {
    return false
  }
  $raw = ''
  $i = 0
  while ($i < $len) {
    $raw = $raw . chr((int) hexdec(substr($h, $i, 2)))
    $i = $i + 2
  }
  return base64_encode($raw)
}
