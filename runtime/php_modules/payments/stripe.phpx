import { result_err } from 'core/result'

// Stripe provider — stub.
//
// Every method returns Err('not_implemented') until the real Connect Express
// wiring lands under issue #94 (Stripe Connect: onboarding, charges, webhooks).
//
// Kept loadable so the @deka/payments module graph stays stable regardless
// of which providers are wired up yet. The interface surface is fixed by
// index.phpx — all three stubs match it so the admin UI and checkout code
// can `import { stripe_provider } from 'payments'` today.

export function stripe_name() {
  return 'stripe'
}

