import { result_ok, result_err, result_is_ok } from 'core/result'
import { hmac_sha256_hex, secure_compare } from 'crypto'
import { json_encode, json_decode } from 'encoding/json'
import { now_ms } from 'time'

import { validate_return_url } from './return_url.phpx'
import { oauth_state_issue, oauth_state_consume } from './oauth_state.phpx'
import { authorize_refund, require_refund_reason, log_refund_attempt } from './refund_auth.phpx'
import { new_connected_account, new_charge, new_refund, new_event, new_account_status } from './types.phpx'

// @deka/payments/stripe — Stripe Connect Express integration (issue #94).
//
// This module backs the store-admin routes
//   /api/payments/connect/stripe/start
//   /api/payments/connect/stripe/callback
//   /api/payments/connect/stripe/status
//   /api/payments/connect/stripe/disconnect
// and the storefront-checkout charge path. It talks to Stripe's public API
// via a pluggable HTTP transport (`$http` — a callable `function($req) -> $res`)
// so unit tests can inject deterministic responses without a real network
// round-trip. Production callers pass a transport that funnels requests
// through a runtime fetch op; a future @deka/http module will formalize
// that — for now, the transport contract is:
//
//     function($request)
//       $request = {
//         method: 'GET'|'POST'|'DELETE',
//         url: string,             // full https:// URL
//         headers: map<string, string>,
//         body: string,            // "" for GET
//       }
//       returns {
//         ok: bool,
//         status: int,             // HTTP status
//         body: string,            // response body
//         error: string,           // populated when ok=false
//       }
//
// Every Stripe call returns Result<T, string>. Errors are strings with
// `stripe:` prefix for easy logging (`stripe:http_failed`, `stripe:api_error:<code>`).
//
// Security baseline (see issues #118, #120, #123):
//   - #118 — OAuth state: `stripe_connect_url()` always issues a fresh
//     Redis-backed state token bound to the caller's shop_id and session
//     jti. `stripe_handle_callback()` consumes the state (one-time-use) and
//     rejects any callback whose state doesn't match.
//   - #120 — return_url allowlist: `validate_return_url()` is called before
//     any Stripe API hit. An invalid URL short-circuits with
//     `stripe:invalid_return_url` — Stripe never sees an attacker domain.
//   - #123 — refund authorization: `stripe_refund()` requires an `actor`
//     with a privileged role, a non-empty `reason`, and writes a
//     RefundAudit entry for every attempt (success or failure).
//
// Env vars (read from $_ENV):
//   STRIPE_SECRET_KEY      — sk_live_* or sk_test_* for API calls.
//   STRIPE_CLIENT_ID       — ca_* OAuth client (not used for Express but
//                            required if we ever expose Standard).
//   STRIPE_WEBHOOK_SECRET  — whsec_* for webhook signature verification.

const STRIPE_API_BASE = 'https://api.stripe.com/v1'

// ---------------------------------------------------------------------------
// Public surface
// ---------------------------------------------------------------------------

export function stripe_name() {
  return 'stripe'
}

/// docid: phpx/payments/stripe_connect_url()
/// <Function name="stripe_connect_url">
///   <Description>Start Stripe Connect Express onboarding. Validates the return_url, issues an OAuth state, creates a Stripe Account + AccountLink, and returns the hosted onboarding URL.</Description>
///   <ReturnType type="mixed" />
/// </Function>
export function stripe_connect_url($return_url, $shop_id, $session_jti = '', $http = false) {
  $url_check = validate_return_url($return_url)
  if (!result_is_ok($url_check)) {
    return result_err('stripe:invalid_return_url')
  }
  $clean_return = $url_check->value

  if (!is_string($shop_id) || strlen($shop_id) === 0) {
    return result_err('stripe:missing_shop_id')
  }

  // Session jti binding. Callers in the route handler always pass a jti;
  // if empty (e.g. a system invocation), we still require SOMETHING so the
  // state record has an audit trail. Route handlers SHOULD pass a real jti.
  $jti = is_string($session_jti) && strlen($session_jti) > 0 ? $session_jti : ('system-' . $shop_id)

  $state_res = oauth_state_issue($shop_id, 'stripe', $jti)
  if (!result_is_ok($state_res)) {
    return result_err('stripe:state_issue_failed')
  }
  $state = $state_res->value

  $secret = env_get('STRIPE_SECRET_KEY')
  if (strlen($secret) === 0) {
    return result_err('stripe:missing_secret_key')
  }

  // Step 1 — create an Express account.
  $acct_req = {
    method: 'POST',
    url: STRIPE_API_BASE . '/accounts',
    headers: stripe_default_headers($secret),
    body: urlencode_form({
      type: 'express',
      'metadata[shop_id]': '' . $shop_id,
      'metadata[state]': $state,
    }),
  }
  $acct_res = http_call($http, $acct_req)
  if (!result_is_ok($acct_res)) {
    return $acct_res
  }
  $acct = $acct_res->value
  $account_id = pick_string($acct, 'id')
  if (strlen($account_id) === 0) {
    return result_err('stripe:account_create_malformed')
  }

  // Step 2 — create an AccountLink for onboarding. The `state` parameter is
  // embedded in the return_url so Stripe will echo it back to us (we then
  // consume it via oauth_state_consume()).
  $refresh = $clean_return . (strpos($clean_return, '?') === false ? '?' : '&') . 'stripe_refresh=1'
  $return_with_state = $clean_return . (strpos($clean_return, '?') === false ? '?' : '&') . 'state=' . urlencode($state) . '&stripe_account=' . urlencode($account_id)

  $link_req = {
    method: 'POST',
    url: STRIPE_API_BASE . '/account_links',
    headers: stripe_default_headers($secret),
    body: urlencode_form({
      account: $account_id,
      refresh_url: $refresh,
      return_url: $return_with_state,
      type: 'account_onboarding',
    }),
  }
  $link_res = http_call($http, $link_req)
  if (!result_is_ok($link_res)) {
    return $link_res
  }
  $link = $link_res->value
  $hosted_url = pick_string($link, 'url')
  if (strlen($hosted_url) === 0) {
    return result_err('stripe:account_link_malformed')
  }

  return result_ok({
    url: $hosted_url,
    account_id: $account_id,
    state: $state,
  })
}

/// docid: phpx/payments/stripe_handle_callback()
/// <Function name="stripe_handle_callback">
///   <Description>Handle the Stripe Connect return. Verifies the state (CSRF), fetches the Account, and returns a ConnectedAccount with charges_enabled reflecting the current Stripe state.</Description>
///   <ReturnType type="mixed" />
/// </Function>
export function stripe_handle_callback($query, $expected_shop_id, $expected_jti, $http = false) {
  $state = pick_query($query, 'state')
  if (strlen($state) === 0) {
    return result_err('stripe:missing_state')
  }

  $consume = oauth_state_consume($state, $expected_shop_id, 'stripe', $expected_jti)
  if (!result_is_ok($consume)) {
    return result_err('stripe:invalid_state')
  }

  $account_id = pick_query($query, 'stripe_account')
  if (strlen($account_id) === 0) {
    $account_id = pick_query($query, 'account_id')
  }
  if (strlen($account_id) === 0) {
    return result_err('stripe:missing_account_id')
  }

  $secret = env_get('STRIPE_SECRET_KEY')
  if (strlen($secret) === 0) {
    return result_err('stripe:missing_secret_key')
  }

  $req = {
    method: 'GET',
    url: STRIPE_API_BASE . '/accounts/' . urlencode($account_id),
    headers: stripe_default_headers($secret),
    body: '',
  }
  $res = http_call($http, $req)
  if (!result_is_ok($res)) {
    return $res
  }
  $acct = $res->value
  $charges_enabled = pick_bool($acct, 'charges_enabled')
  $details_submitted = pick_bool($acct, 'details_submitted')

  return result_ok(new_connected_account(
    'stripe',
    $account_id,
    $charges_enabled,
    now_ms(),
    {
      details_submitted: $details_submitted ? 'true' : 'false',
    }
  ))
}

/// docid: phpx/payments/stripe_create_charge()
/// <Function name="stripe_create_charge">
///   <Description>Create a Stripe PaymentIntent on behalf of a connected account with an application_fee_amount. Returns a Charge with status reflecting the intent's status.</Description>
///   <ReturnType type="mixed" />
/// </Function>
export function stripe_create_charge($account, $amount_cents, $currency, $platform_fee_cents, $idempotency_key, $http = false) {
  $account_id = pick_string($account, 'account_id')
  if (strlen($account_id) === 0) {
    return result_err('stripe:missing_account_id')
  }
  $amt = (int) $amount_cents
  if ($amt <= 0) {
    return result_err('stripe:amount_invalid')
  }
  $fee = (int) $platform_fee_cents
  if ($fee < 0 || $fee > $amt) {
    return result_err('stripe:fee_invalid')
  }
  $cur = strtolower('' . $currency)
  if (strlen($cur) === 0) {
    $cur = 'usd'
  }
  $idem = '' . $idempotency_key
  if (strlen($idem) === 0) {
    return result_err('stripe:idempotency_key_required')
  }

  $secret = env_get('STRIPE_SECRET_KEY')
  if (strlen($secret) === 0) {
    return result_err('stripe:missing_secret_key')
  }

  $headers = stripe_default_headers($secret)
  $headers['Idempotency-Key'] = $idem
  $headers['Stripe-Account'] = $account_id

  $body_map = {
    amount: '' . $amt,
    currency: $cur,
    'automatic_payment_methods[enabled]': 'true',
  }
  if ($fee > 0) {
    $body_map['application_fee_amount'] = '' . $fee
  }

  $req = {
    method: 'POST',
    url: STRIPE_API_BASE . '/payment_intents',
    headers: $headers,
    body: urlencode_form($body_map),
  }
  $res = http_call($http, $req)
  if (!result_is_ok($res)) {
    return $res
  }
  $intent = $res->value
  $id = pick_string($intent, 'id')
  if (strlen($id) === 0) {
    return result_err('stripe:payment_intent_malformed')
  }
  $status = pick_string($intent, 'status')
  if (strlen($status) === 0) {
    $status = 'requires_payment_method'
  }

  return result_ok(new_charge($id, 'stripe', $amt, $cur, $fee, $status))
}

/// docid: phpx/payments/stripe_refund()
/// <Function name="stripe_refund">
///   <Description>Refund a Stripe charge. Requires an authorized actor (owner/admin) and a non-empty reason; writes a RefundAudit entry for every attempt.</Description>
///   <ReturnType type="mixed" />
/// </Function>
export function stripe_refund($account, $charge_id, $amount_cents, $actor, $shop_id, $reason, $charge_amount_cents = 0, $http = false) {
  $reason_check = require_refund_reason($reason)
  if (!result_is_ok($reason_check)) {
    log_refund_attempt($shop_id, $actor, $charge_id, $amount_cents, '' . $reason, 'rejected', $reason_check->error)
    return result_err('stripe:' . $reason_check->error)
  }
  $clean_reason = $reason_check->value

  $auth_check = authorize_refund($actor, $shop_id, $amount_cents, $charge_amount_cents)
  if (!result_is_ok($auth_check)) {
    log_refund_attempt($shop_id, $actor, $charge_id, $amount_cents, $clean_reason, 'rejected', $auth_check->error)
    return result_err('stripe:' . $auth_check->error)
  }

  $account_id = pick_string($account, 'account_id')
  if (strlen($account_id) === 0) {
    log_refund_attempt($shop_id, $actor, $charge_id, $amount_cents, $clean_reason, 'rejected', 'missing_account_id')
    return result_err('stripe:missing_account_id')
  }
  $cid = '' . $charge_id
  if (strlen($cid) === 0) {
    log_refund_attempt($shop_id, $actor, $charge_id, $amount_cents, $clean_reason, 'rejected', 'missing_charge_id')
    return result_err('stripe:missing_charge_id')
  }
  $amt = (int) $amount_cents

  $secret = env_get('STRIPE_SECRET_KEY')
  if (strlen($secret) === 0) {
    log_refund_attempt($shop_id, $actor, $charge_id, $amount_cents, $clean_reason, 'rejected', 'missing_secret_key')
    return result_err('stripe:missing_secret_key')
  }

  $headers = stripe_default_headers($secret)
  $headers['Stripe-Account'] = $account_id

  // Stripe refund endpoint accepts either `payment_intent` or `charge`. We
  // support payment_intent IDs (pi_*) since #94's create path returns them.
  $body_map = {
    payment_intent: $cid,
    amount: '' . $amt,
    reason: 'requested_by_customer',
    'metadata[reason]': $clean_reason,
    'metadata[actor_user_id]': pick_string($actor, 'user_id'),
    'metadata[actor_role]': pick_string($actor, 'role'),
  }

  $req = {
    method: 'POST',
    url: STRIPE_API_BASE . '/refunds',
    headers: $headers,
    body: urlencode_form($body_map),
  }
  $res = http_call($http, $req)
  if (!result_is_ok($res)) {
    log_refund_attempt($shop_id, $actor, $charge_id, $amount_cents, $clean_reason, 'failed', $res->error)
    return $res
  }
  $refund = $res->value
  $rid = pick_string($refund, 'id')
  if (strlen($rid) === 0) {
    log_refund_attempt($shop_id, $actor, $charge_id, $amount_cents, $clean_reason, 'failed', 'refund_malformed')
    return result_err('stripe:refund_malformed')
  }
  $status = pick_string($refund, 'status')
  if (strlen($status) === 0) {
    $status = 'pending'
  }

  log_refund_attempt($shop_id, $actor, $charge_id, $amount_cents, $clean_reason, 'success', '')
  return result_ok(new_refund($rid, 'stripe', $cid, $amt, $status))
}

/// docid: phpx/payments/stripe_webhook_verify()
/// <Function name="stripe_webhook_verify">
///   <Description>Verify a Stripe-Signature header (`t=<ts>,v1=<sig>`). Returns Ok(Event) on valid signature + fresh timestamp, Err(reason) otherwise.</Description>
///   <ReturnType type="mixed" />
/// </Function>
export function stripe_webhook_verify($body, $signature_header, $secret, $tolerance_seconds = 300) {
  if (!is_string($body) || !is_string($signature_header) || !is_string($secret)) {
    return result_err('stripe:invalid_signature_inputs')
  }
  if (strlen($signature_header) === 0 || strlen($secret) === 0) {
    return result_err('stripe:invalid_signature_inputs')
  }

  // Parse Stripe-Signature: `t=<unix_ts>,v1=<hex_hmac>[,v1=...]`. We
  // accept multiple v1 entries (rotation) and succeed if any match.
  $parts = explode(',', $signature_header)
  $timestamp = ''
  $v1s = []
  foreach ($parts as $part) {
    $p = trim($part)
    $eq = strpos($p, '=')
    if ($eq === false) {
      continue
    }
    $k = substr($p, 0, $eq)
    $v = substr($p, $eq + 1)
    if ($k === 't') {
      $timestamp = $v
    } else if ($k === 'v1') {
      $v1s[] = $v
    }
  }
  if (strlen($timestamp) === 0 || count($v1s) === 0) {
    return result_err('stripe:malformed_signature')
  }

  // Replay protection — reject signatures older than tolerance.
  $ts_i = (int) $timestamp
  if ($ts_i <= 0) {
    return result_err('stripe:malformed_timestamp')
  }
  $now_s = (int) (now_ms() / 1000)
  $age = $now_s - $ts_i
  if ($age < 0) {
    $age = -$age
  }
  if ($age > (int) $tolerance_seconds) {
    return result_err('stripe:timestamp_out_of_range')
  }

  $signed_payload = $timestamp . '.' . $body
  $expected = hmac_sha256_hex($signed_payload, $secret)
  if (!is_string($expected) || strlen($expected) === 0) {
    return result_err('stripe:hmac_compute_failed')
  }
  $expected = strtolower($expected)

  $matched = false
  foreach ($v1s as $sig) {
    if (secure_compare($expected, strtolower('' . $sig))) {
      $matched = true
    }
  }
  if (!$matched) {
    return result_err('stripe:signature_mismatch')
  }

  $decoded = json_decode($body, true)
  if (!is_array($decoded)) {
    return result_err('stripe:event_body_invalid_json')
  }
  $id = array_key_exists('id', $decoded) ? ('' . $decoded['id']) : ''
  $type = array_key_exists('type', $decoded) ? ('' . $decoded['type']) : ''
  $created = array_key_exists('created', $decoded) ? ((int) $decoded['created']) * 1000 : now_ms()
  $data = array_key_exists('data', $decoded) ? $decoded['data'] : []

  return result_ok(new_event($id, 'stripe', $type, $created, $data))
}

/// docid: phpx/payments/stripe_account_status()
/// <Function name="stripe_account_status">
///   <Description>Fetch the latest AccountStatus from Stripe. Returns Ok(AccountStatus) reflecting charges_enabled and any disabled_reason.</Description>
///   <ReturnType type="mixed" />
/// </Function>
export function stripe_account_status($account, $http = false) {
  $account_id = pick_string($account, 'account_id')
  if (strlen($account_id) === 0) {
    return result_err('stripe:missing_account_id')
  }
  $secret = env_get('STRIPE_SECRET_KEY')
  if (strlen($secret) === 0) {
    return result_err('stripe:missing_secret_key')
  }
  $req = {
    method: 'GET',
    url: STRIPE_API_BASE . '/accounts/' . urlencode($account_id),
    headers: stripe_default_headers($secret),
    body: '',
  }
  $res = http_call($http, $req)
  if (!result_is_ok($res)) {
    return $res
  }
  $acct = $res->value
  $charges_enabled = pick_bool($acct, 'charges_enabled')
  $disabled_reason = ''
  if (is_array($acct) && array_key_exists('requirements', $acct) && is_array($acct['requirements'])) {
    if (array_key_exists('disabled_reason', $acct['requirements'])) {
      $dr = $acct['requirements']['disabled_reason']
      if (isset($dr) && $dr !== false) {
        $disabled_reason = '' . $dr
      }
    }
  }
  $requirements_due = []
  if (is_array($acct) && array_key_exists('requirements', $acct) && is_array($acct['requirements'])) {
    if (array_key_exists('currently_due', $acct['requirements']) && is_array($acct['requirements']['currently_due'])) {
      $requirements_due = $acct['requirements']['currently_due']
    }
  }
  return result_ok(new_account_status('stripe', $account_id, $charges_enabled, $disabled_reason, $requirements_due))
}

/// docid: phpx/payments/stripe_disconnect()
/// <Function name="stripe_disconnect">
///   <Description>Revoke the connected account. Stripe Connect Express uses the OAuth deauthorize endpoint — for Standard this is required; for Express, we simply instruct the caller to clear the Shop fields.</Description>
///   <ReturnType type="mixed" />
/// </Function>
export function stripe_disconnect($account, $http = false) {
  $account_id = pick_string($account, 'account_id')
  if (strlen($account_id) === 0) {
    return result_err('stripe:missing_account_id')
  }
  $secret = env_get('STRIPE_SECRET_KEY')
  if (strlen($secret) === 0) {
    return result_err('stripe:missing_secret_key')
  }
  // DELETE /v1/accounts/{id} — only works for Express/Standard accounts
  // that were created by this platform (which is our case).
  $req = {
    method: 'DELETE',
    url: STRIPE_API_BASE . '/accounts/' . urlencode($account_id),
    headers: stripe_default_headers($secret),
    body: '',
  }
  $res = http_call($http, $req)
  if (!result_is_ok($res)) {
    return $res
  }
  return result_ok({
    account_id: $account_id,
    disconnected: true,
  })
}

// ---------------------------------------------------------------------------
// HTTP helpers
// ---------------------------------------------------------------------------

function stripe_default_headers($secret) {
  return {
    Authorization: 'Bearer ' . $secret,
    'Content-Type': 'application/x-www-form-urlencoded',
    Accept: 'application/json',
    'Stripe-Version': '2024-06-20',
  }
}

function http_call($http, $request) {
  if (!is_callable($http)) {
    return result_err('stripe:no_http_transport')
  }
  $resp = $http($request)
  if (!is_array($resp) && !is_object($resp)) {
    return result_err('stripe:transport_returned_nothing')
  }
  $ok = is_array($resp) ? (array_key_exists('ok', $resp) && $resp['ok'] === true) : (isset($resp->ok) && $resp->ok === true)
  if (!$ok) {
    $err = 'stripe:http_failed'
    if (is_array($resp) && array_key_exists('error', $resp)) {
      $err = 'stripe:http_failed:' . $resp['error']
    } else if (is_object($resp) && isset($resp->error)) {
      $err = 'stripe:http_failed:' . $resp->error
    }
    return result_err($err)
  }
  $status = is_array($resp) ? (int) $resp['status'] : (int) $resp->status
  $body = is_array($resp) ? ('' . $resp['body']) : ('' . $resp->body)

  $decoded = json_decode($body, true)
  if (!is_array($decoded)) {
    $decoded = []
  }
  if ($status < 200 || $status >= 300) {
    $code = ''
    if (array_key_exists('error', $decoded) && is_array($decoded['error'])) {
      if (array_key_exists('code', $decoded['error'])) {
        $code = '' . $decoded['error']['code']
      } else if (array_key_exists('type', $decoded['error'])) {
        $code = '' . $decoded['error']['type']
      }
    }
    return result_err('stripe:api_error:' . ($status) . ':' . $code)
  }
  return result_ok($decoded)
}

function urlencode_form($map) {
  $out = ''
  if (is_array($map)) {
    foreach ($map as $k => $v) {
      if (strlen($out) > 0) {
        $out = $out . '&'
      }
      $out = $out . urlencode('' . $k) . '=' . urlencode('' . $v)
    }
  }
  return $out
}

function pick_string($obj, $key) {
  if (is_array($obj) && array_key_exists($key, $obj)) {
    $v = $obj[$key]
    if (!isset($v) || $v === false) {
      return ''
    }
    return '' . $v
  }
  if (is_object($obj) && isset($obj->$key)) {
    $v = $obj->$key
    if (!isset($v) || $v === false) {
      return ''
    }
    return '' . $v
  }
  return ''
}

function pick_bool($obj, $key) {
  if (is_array($obj) && array_key_exists($key, $obj)) {
    return $obj[$key] === true
  }
  if (is_object($obj) && isset($obj->$key)) {
    return $obj->$key === true
  }
  return false
}

function pick_query($query, $key) {
  if (is_array($query) && array_key_exists($key, $query)) {
    $v = $query[$key]
    if (!isset($v) || $v === false) {
      return ''
    }
    return '' . $v
  }
  if (is_object($query) && isset($query->$key)) {
    $v = $query->$key
    if (!isset($v) || $v === false) {
      return ''
    }
    return '' . $v
  }
  return ''
}

function env_get($name) {
  if (is_array($_ENV) && array_key_exists($name, $_ENV)) {
    $v = $_ENV[$name]
    if (!isset($v) || $v === false) {
      return ''
    }
    return '' . $v
  }
  if (is_array($_SERVER) && array_key_exists($name, $_SERVER)) {
    $v = $_SERVER[$name]
    if (!isset($v) || $v === false) {
      return ''
    }
    return '' . $v
  }
  return ''
}
