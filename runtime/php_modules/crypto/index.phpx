import { from_string as bytes_from_string, from_array as bytes_from_array, to_array as bytes_to_array } from 'bytes'
import { result_ok, result_err, result_is_ok } from 'core/result'
import { bridge } from 'core/bridge'

function to_assoc($value) {
  if (is_array($value)) {
    $out = []
    $is_entries = true
    foreach ($value as $entry) {
      if (!is_array($entry) || count($entry) !== 2 || !is_string($entry[0])) {
        $is_entries = false
        break
      }
      $out[$entry[0]] = $entry[1]
    }
    if ($is_entries) {
      return $out
    }
    return $value
  }
  return null
}

function to_string_value($value) {
  if (is_string($value)) {
    return $value
  }
  if (is_array($value)) {
    return json_encode($value)
  }
  if (is_object($value)) {
    return json_encode($value)
  }
  return '' . $value
}

function hex_from_bytes($bytes) {
  $arr = bytes_to_array($bytes)
  $hex = ''
  foreach ($arr as $v) {
    $part = $v->toString(16)
    if (strlen($part) < 2) {
      $part = '0' . $part
    }
    $hex = $hex . $part
  }
  return $hex
}

/// docid: phpx/crypto/random_bytes_result()
/// <Function name="random_bytes_result">
///   <Description>PHPX standard module function `random_bytes_result` from `crypto`.</Description>
///   <ReturnType type="mixed" />
/// </Function>
export function random_bytes_result($len = 32) {
  $n = (int) $len
  if ($n <= 0) {
    return result_err('length must be > 0')
  }
  $raw = bridge('crypto', 'random_bytes', { length: $n })
  $assoc = to_assoc($raw)
  if (!is_array($assoc) || !array_key_exists('ok', $assoc) || !$assoc['ok']) {
    $msg = is_array($assoc) && array_key_exists('error', $assoc) ? $assoc['error'] : 'crypto random_bytes failed'
    return result_err($msg)
  }
  if (!array_key_exists('data', $assoc) || !is_array($assoc['data'])) {
    return result_err('crypto random_bytes returned invalid payload')
  }
  return result_ok(bytes_from_array($assoc['data']))
}

/// docid: phpx/crypto/random_hex()
/// <Function name="random_hex">
///   <Description>PHPX standard module function `random_hex` from `crypto`.</Description>
///   <ReturnType type="mixed" />
/// </Function>
export function random_hex($len = 32) {
  $res = random_bytes_result($len)
  if (!result_is_ok($res)) {
    return $res
  }
  return result_ok(hex_from_bytes($res->value))
}

/// docid: phpx/crypto/sha256_hex()
/// <Function name="sha256_hex">
///   <Description>PHPX standard module function `sha256_hex` from `crypto`.</Description>
///   <ReturnType type="mixed" />
/// </Function>
export function sha256_hex($value) {
  return hash('sha256', to_string_value($value))
}

/// docid: phpx/crypto/hmac_sha256_hex()
/// <Function name="hmac_sha256_hex">
///   <Description>PHPX standard module function `hmac_sha256_hex` from `crypto`.</Description>
///   <ReturnType type="mixed" />
/// </Function>
export function hmac_sha256_hex($value, $key) {
  return hash_hmac('sha256', to_string_value($value), to_string_value($key))
}

/// docid: phpx/crypto/bcrypt_verify()
/// <Function name="bcrypt_verify">
///   <Description>Verify a password against a bcrypt hash. Returns true on match, false otherwise.</Description>
///   <ReturnType type="bool" />
/// </Function>
export function bcrypt_verify($password, $hash) {
  $raw = bridge('crypto', 'bcrypt_verify', {
    password: to_string_value($password),
    hash: to_string_value($hash),
  })
  $assoc = to_assoc($raw)
  if (!is_array($assoc) || !array_key_exists('ok', $assoc) || !$assoc['ok']) {
    return false
  }
  if (!array_key_exists('valid', $assoc) || !is_bool($assoc['valid'])) {
    return false
  }
  return $assoc['valid']
}

/// docid: phpx/crypto/hmac_sha256_bytes()
/// <Function name="hmac_sha256_bytes">
///   <Description>PHPX standard module function `hmac_sha256_bytes` from `crypto`.</Description>
///   <ReturnType type="mixed" />
/// </Function>
export function hmac_sha256_bytes($value, $key) {
  $raw = hash_hmac('sha256', to_string_value($value), to_string_value($key), true)
  return bytes_from_string($raw)
}

/// docid: phpx/crypto/secure_compare()
/// <Function name="secure_compare">
///   <Description>PHPX standard module function `secure_compare` from `crypto`.</Description>
///   <ReturnType type="mixed" />
/// </Function>
export function secure_compare($a, $b) {
  return hash_equals(to_string_value($a), to_string_value($b))
}

/// docid: phpx/crypto/uuid_v4()
/// <Function name="uuid_v4">
///   <Description>PHPX standard module function `uuid_v4` from `crypto`.</Description>
///   <ReturnType type="mixed" />
/// </Function>
export function uuid_v4() {
  $res = random_bytes_result(16)
  if (!result_is_ok($res)) {
    return $res
  }
  $arr = bytes_to_array($res->value)
  if (count($arr) !== 16) {
    return result_err('failed to generate uuid bytes')
  }
  $arr[6] = ($arr[6] & 0x0f) | 0x40
  $arr[8] = ($arr[8] & 0x3f) | 0x80
  $hex = ''
  foreach ($arr as $v) {
    $part = $v->toString(16)
    if (strlen($part) < 2) {
      $part = '0' . $part
    }
    $hex = $hex . $part
  }
  $uuid = substr($hex, 0, 8)
    . '-'
    . substr($hex, 8, 4)
    . '-'
    . substr($hex, 12, 4)
    . '-'
    . substr($hex, 16, 4)
    . '-'
    . substr($hex, 20, 12)
  return result_ok($uuid)
}

// AES-256-GCM — authenticated encryption with associated data.
//
// Callers pass:
//   - $key — 32-byte `bytes` value (the symmetric key).
//   - $nonce — 12-byte `bytes` value. MUST be unique per encryption.
//     Re-using a nonce with the same key is catastrophic for GCM.
//   - $plaintext / $ciphertext — `bytes` values. Ciphertext includes the
//     16-byte auth tag appended to the raw encryption output.
//   - $aad — optional associated data (string or bytes). Authenticated
//     but not encrypted. Pass '' if none.
//
// Returns `Result<bytes, string>`. Decrypt failures (wrong key, tampered
// ciphertext, tampered tag, AAD mismatch) all collapse to a generic
// `aes_decrypt_failed` so the caller can't use the error channel as an
// oracle.

/// docid: phpx/crypto/aes_256_gcm_encrypt()
/// <Function name="aes_256_gcm_encrypt">
///   <Description>AES-256-GCM encrypt. Returns Ok(bytes) on success, Err(string) otherwise.</Description>
///   <ReturnType type="mixed" />
/// </Function>
export function aes_256_gcm_encrypt($key, $nonce, $plaintext, $aad = '') {
  $key_arr = is_string($key) ? bytes_to_array(bytes_from_string($key)) : bytes_to_array($key)
  $nonce_arr = is_string($nonce) ? bytes_to_array(bytes_from_string($nonce)) : bytes_to_array($nonce)
  $pt_arr = is_string($plaintext) ? bytes_to_array(bytes_from_string($plaintext)) : bytes_to_array($plaintext)
  $aad_arr = is_string($aad) ? bytes_to_array(bytes_from_string($aad)) : bytes_to_array($aad)

  $raw = bridge('crypto', 'aes_256_gcm_encrypt', {
    key: $key_arr,
    nonce: $nonce_arr,
    plaintext: $pt_arr,
    aad: $aad_arr,
  })
  $assoc = to_assoc($raw)
  if (!is_array($assoc) || !array_key_exists('ok', $assoc) || !$assoc['ok']) {
    $msg = is_array($assoc) && array_key_exists('error', $assoc) ? $assoc['error'] : 'aes_encrypt_failed'
    return result_err('' . $msg)
  }
  if (!array_key_exists('data', $assoc) || !is_array($assoc['data'])) {
    return result_err('aes_encrypt_failed')
  }
  return result_ok(bytes_from_array($assoc['data']))
}

/// docid: phpx/crypto/aes_256_gcm_decrypt()
/// <Function name="aes_256_gcm_decrypt">
///   <Description>AES-256-GCM decrypt. Ciphertext MUST include the 16-byte GCM tag appended. Returns Ok(bytes) on success, Err(string) on any failure.</Description>
///   <ReturnType type="mixed" />
/// </Function>
export function aes_256_gcm_decrypt($key, $nonce, $ciphertext, $aad = '') {
  $key_arr = is_string($key) ? bytes_to_array(bytes_from_string($key)) : bytes_to_array($key)
  $nonce_arr = is_string($nonce) ? bytes_to_array(bytes_from_string($nonce)) : bytes_to_array($nonce)
  $ct_arr = is_string($ciphertext) ? bytes_to_array(bytes_from_string($ciphertext)) : bytes_to_array($ciphertext)
  $aad_arr = is_string($aad) ? bytes_to_array(bytes_from_string($aad)) : bytes_to_array($aad)

  $raw = bridge('crypto', 'aes_256_gcm_decrypt', {
    key: $key_arr,
    nonce: $nonce_arr,
    ciphertext: $ct_arr,
    aad: $aad_arr,
  })
  $assoc = to_assoc($raw)
  if (!is_array($assoc) || !array_key_exists('ok', $assoc) || !$assoc['ok']) {
    $msg = is_array($assoc) && array_key_exists('error', $assoc) ? $assoc['error'] : 'aes_decrypt_failed'
    return result_err('' . $msg)
  }
  if (!array_key_exists('data', $assoc) || !is_array($assoc['data'])) {
    return result_err('aes_decrypt_failed')
  }
  return result_ok(bytes_from_array($assoc['data']))
}
