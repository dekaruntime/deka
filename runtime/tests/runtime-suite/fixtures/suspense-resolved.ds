const ui = globalThis.deka.ui;

async fn Slow(): Promise<object> {
  return ui.jsx("p", { children: "loaded" });
}

const node = ui.jsx(ui.Suspense, {
  fallback: ui.jsx("span", { children: "loading" }),
  children: ui.jsx(Slow, {})
});

async fn main(): Promise<void> {
  const result = await ui.renderToStringAsync(node);
  console.log(result.html);
}

main();
