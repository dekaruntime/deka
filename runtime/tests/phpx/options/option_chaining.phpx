/*
TEST: Option chaining edge cases
Covers: nested Option unwrapping, None fallback propagation, lazy fallback evaluation.
*/

import { option_some, option_none } from 'core/option';

$outer = option_some(option_some(42));
$missing = option_some(option_none());
$lazy = option_none();

echo 'value=' . $outer->unwrap()->unwrap_or('missing') . "\n";
echo 'fallback=' . $missing->unwrap()->unwrap_or('missing') . "\n";
echo 'lazy=' . $lazy->unwrap_or_else(fn() => 'fallback-called') . "\n";
