/*
TEST: No-null absence semantics
Covers: isset checks and Option values as the observable absence model.
*/

import { option_some, option_none } from 'core/option';

$map = ['present' => 'value'];
$profile = { name: 'Tana', orders: 0 };

$some = option_some($map['present']);
$none = option_none();

echo (isset($map['present']) ? 'present' : 'missing') . "\n";
echo (isset($map['missing']) ? 'present' : 'missing') . "\n";
echo (isset($profile.name) ? 'has-name' : 'no-name') . "\n";
echo (isset($profile.plan) ? 'has-plan' : 'no-plan') . "\n";
echo $some->unwrap_or('fallback') . "\n";
echo $none->unwrap_or('fallback') . "\n";
