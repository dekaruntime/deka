struct Request {
    $method: string;
    $path: string;
    $body: Option<string>;
    $shop_id: string;
    $flags: array<string>;
}

struct Response {
    $status: int;
    $body: string;
    $state: HandlerState;
}

enum HandlerState {
    case Ready;
    case Redirect($location: string, $permanent: bool);
}

export function handle($req: Request): Response {
    return Response { $status: 200, $body: "ok", $state: HandlerState::Ready };
}
