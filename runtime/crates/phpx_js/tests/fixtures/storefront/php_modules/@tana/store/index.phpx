// Minimal vendored @tana/store fixture used only by the phpx_js
// storefront_compile test (see issue #52). Not the real @tana/store
// package — just enough exported surface for the compiler's import and
// export validation to resolve successfully without a sibling tana repo.

export function createStore($config) {
    return function($req) {
        return $req
    }
}

export function Header($ctx, $props, $slots) {
    return '<header></header>'
}

export function Hero($ctx, $props, $slots) {
    return '<section class="hero"></section>'
}

export function ProductGrid($ctx, $props, $slots) {
    return '<section class="products"></section>'
}
