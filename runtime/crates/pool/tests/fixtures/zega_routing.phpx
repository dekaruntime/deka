import { run_cql, execute as neo4j_execute } from 'neo4j'
import { get as redis_get, set as redis_set, expire as redis_expire } from 'redis'
import { bridge } from 'core/bridge'

function zega_routing_response() {
    $name = 'Hat'
    $created = neo4j_execute(0, 'CREATE (p:Product {name: $name})', { name: $name })
    cql product = MATCH (p:Product {name: $name}) RETURN p.name AS name;
    $routed = run_cql(0, $product)

    $kv_set = redis_set(0, 'cart', 'sku-1')
    $kv_get = redis_get(0, 'cart')
    $kv_expire = redis_expire(0, 'cart', 60)

    return {
        created: $created,
        routed: $routed,
        kv_set: $kv_set,
        kv_get: $kv_get,
        kv_expire: $kv_expire,
        cql_probe: bridge('neo4j', 'routing_probe', {}),
        kv_probe: bridge('redis', 'routing_probe', {})
    }
}
