[Unit]
Description=Tana Vault Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/tana-vault-agent
Restart=on-failure
RestartSec=2

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/run
ReadOnlyPaths=/etc/tana-vault-agent

[Install]
WantedBy=multi-user.target
