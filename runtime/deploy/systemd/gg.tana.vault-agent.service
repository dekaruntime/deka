[Unit]
Description=Tana Vault Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
SupplementaryGroups=tss
Environment=TANA_VAULT_AGENT_ATTESTATION=hs256-dev
ExecStart=/usr/local/bin/tana-vault-agent
Restart=on-failure
RestartSec=2

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/run
ReadOnlyPaths=/etc/tana-vault-agent
DeviceAllow=/dev/tpm0 rw
DeviceAllow=/dev/tpmrm0 rw

[Install]
WantedBy=multi-user.target
