[Unit]
Description=Tana Gild Privileged Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/gild-agent
Restart=on-failure
RestartSec=2

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=false
ReadWritePaths=/run /etc /home /var/lib/gild /var/log

[Install]
WantedBy=multi-user.target
