// Consumer view for the Harar JSON socket verify boundary.
struct HararVerifyTokenRequest {
    $token: string;
    $audience: string;
    $subject: Option<string>;
    $run_id: Option<string>;
}

struct HararVerifyTokenResponse {
    $ok: bool;
    $valid: Option<bool>;
    $sub: Option<string>;
    $jti: Option<string>;
    $exp: Option<int>;
    $error: Option<string>;
}

export function verify($req: HararVerifyTokenRequest): HararVerifyTokenResponse {
    return HararVerifyTokenResponse {
        $ok: true,
        $valid: Option::Some(false),
        $sub: Option::None,
        $jti: Option::None,
        $exp: Option::None,
        $error: Option::Some("wrong_audience"),
    };
}
