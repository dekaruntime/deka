// Consumer view for GET /v1/jwks. Only public JWK fields are present.
struct HararJwksRequest {
}

struct HararJwk {
    $kty: string;
    $kid: string;
    $crv: string;
    $alg: string;
    $use: string;
    $x: string;
}

struct HararJwksResponse {
    $keys: array<HararJwk>;
}

export function jwks($req: HararJwksRequest): HararJwksResponse {
    return HararJwksResponse { $keys: [] };
}
