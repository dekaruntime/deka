// Consumer model for tcp/tls normalize_result(). The actual entry values are
// PHPX dynamic bridge values; this fixture guards the stable entry-pair shape
// (rather than accidentally reverting routeHostCall to a host object).
struct NetBridgeEntry {
    $key: string;
    $value: string;
}

struct NetBridgeRequest {
    $action: string;
}

struct NetBridgeResponse {
    $entries: array<NetBridgeEntry>;
}

export function net_bridge($req: NetBridgeRequest): NetBridgeResponse {
    return NetBridgeResponse {
        $entries: [
            NetBridgeEntry { $key: "ok", $value: "true" },
        ],
    };
}
