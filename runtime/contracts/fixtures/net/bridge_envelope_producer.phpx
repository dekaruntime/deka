// Producer model for the Rust net bridge decoded by pool's routeHostCall.
// The bridge crosses into PHPX as Object.entries(decoded), so every action
// response is a key/value-entry array. Optional fields model the action
// specific payload from NetResponse: connect/tls_upgrade return handle,
// read returns data/eof, write returns written, and failures return error.
struct NetBridgeEntry {
    $key: string;
    $value: string;
}

struct NetBridgeRequest {
    $action: string;
}

struct NetBridgeResponse {
    $entries: array<NetBridgeEntry>;
}

export function net_bridge($req: NetBridgeRequest): NetBridgeResponse {
    return NetBridgeResponse {
        $entries: [],
    };
}
