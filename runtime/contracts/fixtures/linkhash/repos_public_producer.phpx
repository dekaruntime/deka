// Producer view for `GET /api/repos/public` (git-server/src/public_browse.rs,
// tana#391 / tana#909): the one-shot anonymous repository catalog across
// every namespace whose `repo_visibility` row is `public`.
//
// Mirrors the Rust wire shape exactly:
//   #[derive(Debug, Clone, Serialize)]
//   pub struct PublicRepoSummary {
//       pub owner: String,
//       pub repo: String,
//       pub head_sha: Option<String>,
//   }
//
// `head_sha` is genuinely absent (JSON `null`) when a repo's HEAD can't be
// resolved (e.g. an empty bare repo) — `public_repo_head_sha()` returns
// `None` rather than the handler dropping the row or failing the whole
// catalog. Modeled here as `Option<string>`, not a bare `string`, so a
// PHPX consumer must explicitly account for absence instead of accidentally
// getting away with it via `row_get`'s empty-string fallback.
struct LinkhashReposPublicRequest {
}

struct LinkhashPublicRepoSummary {
    $owner: string;
    $repo: string;
    $head_sha: Option<string>;
}

struct LinkhashReposPublicResponse {
    $repos: array<LinkhashPublicRepoSummary>;
}

export function linkhash_repos_public($req: LinkhashReposPublicRequest): LinkhashReposPublicResponse {
    return LinkhashReposPublicResponse {
        $repos: [],
    };
}
