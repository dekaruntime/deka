// Consumer view: linkha.sh (PHPX, jynx) reading
// `GET /api/scoped-packages/{scope}/{name}/{version}`.
//
// Field access:
//   registry_api.phpx decorateVersionRow() reads created_at, git_ref,
//     git_commit, tree_hash, api_change_kind, required_bump, repo, owner,
//     description, manifest, capability_metadata, api_snapshot
//   main.phpx package detail + install panel additionally read `visibility`
//
// `package_name` and `version` are echoed by the producer but never read here.

struct RegistryReleaseRequest {
    $scope: string;
    $name: string;
    $version: string;
}

struct RegistryReleaseResponse {
    $owner: string;
    $repo: string;
    $description: string;
    $visibility: string;
    $created_at: string;
    $git_ref: string;
    $git_commit: Option<string>;
    $tree_hash: Option<string>;
    $api_change_kind: string;
    $required_bump: string;
    $manifest: string;
    $capability_metadata: string;
    $api_snapshot: string;
}

export function registry_release($req: RegistryReleaseRequest): RegistryReleaseResponse {
    return RegistryReleaseResponse {
        $owner: "",
        $repo: "",
        $description: "",
        $visibility: "private",
        $created_at: "",
        $git_ref: "",
        $git_commit: Option::None,
        $tree_hash: Option::None,
        $api_change_kind: "",
        $required_bump: "",
        $manifest: "",
        $capability_metadata: "",
        $api_snapshot: "",
    };
}
