// Producer view of `GET /api/scoped-packages/{scope}/{name}/{version}` on the
// git.tana.gg registry (gild-vcs, Rust/axum, demon) — the per-release detail
// payload linkha.sh renders on the package detail page.
//
// Shape verified against the live registry on 2026-07-26 (@deka/array@0.1.0).
// `git_commit` and `tree_hash` come back JSON-null for releases published
// before the tree-hash column was backfilled, hence Option<string>.

struct RegistryReleaseRequest {
    $scope: string;
    $name: string;
    $version: string;
}

struct RegistryReleaseResponse {
    $package_name: string;
    $version: string;
    $owner: string;
    $repo: string;
    $description: string;
    $visibility: string;
    $created_at: string;
    $git_ref: string;
    $git_commit: Option<string>;
    $tree_hash: Option<string>;
    $api_change_kind: string;
    $required_bump: string;
    $manifest: string;
    $capability_metadata: string;
    $api_snapshot: string;
}

export function registry_release($req: RegistryReleaseRequest): RegistryReleaseResponse {
    return RegistryReleaseResponse {
        $package_name: "",
        $version: "",
        $owner: "",
        $repo: "",
        $description: "",
        $visibility: "private",
        $created_at: "",
        $git_ref: "",
        $git_commit: Option::None,
        $tree_hash: Option::None,
        $api_change_kind: "",
        $required_bump: "",
        $manifest: "",
        $capability_metadata: "",
        $api_snapshot: "",
    };
}
