// Consumer view: linkha.sh (PHPX, jynx) reading
// `GET /api/scoped-packages/{scope}/{name}/versions`.
//
// Field access:
//   registry_api.phpx versionRowsFromApi() reads `versions` and `latest`
//   main.phpx package detail              reads `latest` and `visibility`
//
// linkha.sh never reads the echoed `name`, so it is deliberately absent here —
// a consumer view declares only what it actually touches.

struct RegistryVersionsRequest {
    $scope: string;
    $name: string;
}

struct RegistryVersionsResponse {
    $latest: string;
    $versions: array<string>;
    $visibility: string;
}

export function registry_versions($req: RegistryVersionsRequest): RegistryVersionsResponse {
    return RegistryVersionsResponse {
        $latest: "",
        $versions: [],
        $visibility: "private",
    };
}
