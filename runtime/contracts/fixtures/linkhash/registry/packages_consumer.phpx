// Consumer view: linkha.sh (PHPX, jynx) reading `GET /api/packages`.
//
// Field access lives in linkhash/phpx/src/services/registry_api.phpx:
//   fetchRegistryPackageRows()      reads `packages` off the payload
//   registryRowFromApiEntry($entry) reads `name`, `latest`, `versions`
//   normalizeVisibility(...)        reads `visibility`
//
// linkha.sh sends no query parameters, so the request carries no fields.

struct RegistryPackagesRequest {
    $limit: Option<int>;
}

struct RegistryPackageEntry {
    $name: string;
    $latest: string;
    $versions: array<string>;
    $visibility: string;
}

struct RegistryPackagesResponse {
    $packages: array<RegistryPackageEntry>;
}

export function registry_packages($req: RegistryPackagesRequest): RegistryPackagesResponse {
    return RegistryPackagesResponse {
        $packages: [],
    };
}
