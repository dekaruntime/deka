// Producer view of `GET /api/scoped-packages/{scope}/{name}/versions` on the
// git.tana.gg registry (gild-vcs, Rust/axum, demon).
//
// Shape verified against the live registry on 2026-07-26:
//   {"latest":"0.1.0","name":"@deka/array","versions":["0.1.0"],
//    "visibility":"public"}

struct RegistryVersionsRequest {
    $scope: string;
    $name: string;
}

struct RegistryVersionsResponse {
    $name: string;
    $latest: string;
    $versions: array<string>;
    $visibility: string;
}

export function registry_versions($req: RegistryVersionsRequest): RegistryVersionsResponse {
    return RegistryVersionsResponse {
        $name: "",
        $latest: "",
        $versions: [],
        $visibility: "private",
    };
}
