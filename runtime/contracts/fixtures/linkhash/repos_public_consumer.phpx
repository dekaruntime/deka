// Consumer view for `GET /api/repos/public`, as read by
// `linkhash_list_repositories()` / `linkhash_list_public_namespaces()` in
// linkhash/website `src/api/linkhash.phpx` (linkhash/website#2).
//
// PHPX has no null, so the consumer cannot receive `Option<string>` as a
// distinct value the way Rust does. The documented convention at this
// boundary: `head_sha` is read via `row_get($row, 'head_sha', '')`, which
// treats an absent/`Option::None` value as the empty string `''`. Call
// sites branch on `$commit !== ''` rather than an `isset()` check — this is
// the explicit, contract-checked version of that convention (see
// linkhash.repos_public in contracts/seams.json), not an accident of
// `row_get`'s fallback behavior.
struct LinkhashReposPublicRequest {
}

struct LinkhashPublicRepoSummary {
    $owner: string;
    $repo: string;
    $head_sha: Option<string>;
}

struct LinkhashReposPublicResponse {
    $repos: array<LinkhashPublicRepoSummary>;
}

export function linkhash_repos_public($req: LinkhashReposPublicRequest): LinkhashReposPublicResponse {
    return LinkhashReposPublicResponse {
        $repos: [
            LinkhashPublicRepoSummary {
                $owner: "",
                $repo: "",
                $head_sha: Option::None,
            },
        ],
    };
}
