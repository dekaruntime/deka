--- a/src/parallel.rs	1969-12-31 17:00:00
+++ b/src/parallel.rs	2026-10-02 22:09:03
@@ -0,0 +1,379 @@
+// Copyright 2025 the Vello Authors
+// SPDX-License-Identifier: Apache-2.0 OR MIT
+
+//! Fork (deka spike): deferred, parallel strip generation with an optional
+//! strip cache.
+//!
+//! `Scene` queues filled/stroked paths as [`PendingPath`] jobs instead of
+//! generating strips immediately. At a flush point (any operation that touches
+//! the recorder or clip state, and before rendering) the queued batch is split
+//! into contiguous, cost-balanced chunks; each chunk is generated by its own
+//! `StripGenerator` into its own `StripStorage` (on worker threads with the
+//! `multithreading` feature), then the chunks are appended to the scene's
+//! storage in submission order, offsetting each strip's alpha index. Strip
+//! generation is a pure function of (path, transform, fill/stroke, aliasing
+//! threshold, viewport), so the merged storage is byte-identical to sequential
+//! generation.
+//!
+//! The strip cache keys each job by a 64-bit hash of exactly those inputs and
+//! reuses the previous frame's strips for unchanged paths.
+
+#[cfg(feature = "multithreading")]
+extern crate std;
+use alloc::vec::Vec;
+use core::ops::Range;
+use hashbrown::HashMap;
+use vello_common::fearless_simd::Level;
+use vello_common::kurbo::{Affine, BezPath, Cap, Join, PathEl, Stroke};
+use vello_common::paint::Paint;
+use vello_common::peniko::Fill;
+use vello_common::strip::Strip;
+use vello_common::strip_generator::{GenerationMode, StripGenerator, StripStorage};
+
+/// The geometry of a queued path.
+#[derive(Debug)]
+pub(crate) enum Geom {
+    Fill(BezPath, Fill),
+    Stroke(BezPath, Stroke),
+}
+
+/// A path draw whose strips have not been generated yet.
+#[derive(Debug)]
+pub(crate) struct PendingPath {
+    pub(crate) geom: Geom,
+    pub(crate) transform: Affine,
+    pub(crate) aliasing_threshold: Option<u8>,
+    pub(crate) paint: Paint,
+}
+
+impl PendingPath {
+    /// Rough generation cost, used to balance chunks.
+    fn cost(&self) -> usize {
+        match &self.geom {
+            Geom::Fill(p, _) => p.elements().len() + 4,
+            Geom::Stroke(p, s) => 2 * p.elements().len() + 4 + s.dash_pattern.len(),
+        }
+    }
+
+    fn key(&self, width: u16, height: u16) -> u64 {
+        let mut h = Hash64::default();
+        h.word(u64::from(width) << 16 | u64::from(height));
+        for c in self.transform.as_coeffs() {
+            h.f64(c);
+        }
+        h.word(self.aliasing_threshold.map_or(1 << 9, u64::from));
+        let path = match &self.geom {
+            Geom::Fill(p, fill) => {
+                h.word(match fill {
+                    Fill::NonZero => 1,
+                    Fill::EvenOdd => 2,
+                });
+                p
+            }
+            Geom::Stroke(p, s) => {
+                h.word(3);
+                h.f64(s.width);
+                h.f64(s.miter_limit);
+                h.word(match s.join {
+                    Join::Bevel => 0,
+                    Join::Miter => 1,
+                    Join::Round => 2,
+                });
+                for cap in [s.start_cap, s.end_cap] {
+                    h.word(match cap {
+                        Cap::Butt => 0,
+                        Cap::Square => 1,
+                        Cap::Round => 2,
+                    });
+                }
+                h.f64(s.dash_offset);
+                for d in s.dash_pattern.iter() {
+                    h.f64(*d);
+                }
+                p
+            }
+        };
+        for el in path.elements() {
+            match *el {
+                PathEl::MoveTo(p) => {
+                    h.word(10);
+                    h.f64(p.x);
+                    h.f64(p.y);
+                }
+                PathEl::LineTo(p) => {
+                    h.word(11);
+                    h.f64(p.x);
+                    h.f64(p.y);
+                }
+                PathEl::QuadTo(a, b) => {
+                    h.word(12);
+                    for p in [a, b] {
+                        h.f64(p.x);
+                        h.f64(p.y);
+                    }
+                }
+                PathEl::CurveTo(a, b, c) => {
+                    h.word(13);
+                    for p in [a, b, c] {
+                        h.f64(p.x);
+                        h.f64(p.y);
+                    }
+                }
+                PathEl::ClosePath => h.word(14),
+            }
+        }
+        h.0
+    }
+}
+
+/// Small, fast 64-bit mixing hash (not cryptographic). A production version
+/// should use 128 bits or verify on hit; collisions here would reuse the wrong
+/// strips.
+#[derive(Default)]
+struct Hash64(u64);
+impl Hash64 {
+    #[inline(always)]
+    fn word(&mut self, w: u64) {
+        self.0 = (self.0 ^ w).wrapping_mul(0x9E37_79B9_7F4A_7C15).rotate_left(29);
+    }
+    #[inline(always)]
+    fn f64(&mut self, v: f64) {
+        self.word(v.to_bits());
+    }
+}
+
+/// Strips of one path with alpha indices rebased to 0.
+#[derive(Debug, Default)]
+struct CachedStrips {
+    strips: Vec<Strip>,
+    alphas: Vec<u8>,
+}
+
+#[derive(Debug)]
+struct Worker {
+    generator: StripGenerator,
+    storage: StripStorage,
+    /// Strip range (within `storage`) per job of this chunk.
+    ranges: Vec<Range<usize>>,
+    /// New cache entries produced by this chunk (key, strips).
+    misses: Vec<(u64, CachedStrips)>,
+    hits: Vec<u64>,
+}
+
+impl Worker {
+    fn new(width: u16, height: u16, level: Level) -> Self {
+        Self {
+            generator: StripGenerator::new(width, height, level),
+            storage: StripStorage::new(GenerationMode::Append),
+            ranges: Vec::new(),
+            misses: Vec::new(),
+            hits: Vec::new(),
+        }
+    }
+
+    fn run(&mut self, jobs: &[PendingPath], cache: Option<&HashMap<u64, CachedStrips>>, width: u16, height: u16) {
+        self.storage.clear();
+        self.ranges.clear();
+        self.misses.clear();
+        self.hits.clear();
+        for job in jobs {
+            let s0 = self.storage.strips.len();
+            let a0 = self.storage.alphas.len();
+            let key = cache.map(|_| job.key(width, height));
+            if let (Some(cache), Some(key)) = (cache, key)
+                && let Some(hit) = cache.get(&key)
+            {
+                let base = a0 as u32;
+                self.storage.alphas.extend_from_slice(&hit.alphas);
+                self.storage.strips.extend(hit.strips.iter().map(|s| {
+                    let mut s = *s;
+                    s.set_alpha_idx(s.alpha_idx() + base);
+                    s
+                }));
+                self.hits.push(key);
+            } else {
+                match &job.geom {
+                    Geom::Fill(path, fill) => self.generator.generate_filled_path(
+                        path,
+                        *fill,
+                        job.transform,
+                        job.aliasing_threshold,
+                        &mut self.storage,
+                        None,
+                    ),
+                    Geom::Stroke(path, stroke) => self.generator.generate_stroked_path(
+                        path,
+                        stroke,
+                        job.transform,
+                        job.aliasing_threshold,
+                        &mut self.storage,
+                        None,
+                    ),
+                }
+                if let Some(key) = key {
+                    let base = a0 as u32;
+                    self.misses.push((
+                        key,
+                        CachedStrips {
+                            strips: self.storage.strips[s0..]
+                                .iter()
+                                .map(|s| {
+                                    let mut s = *s;
+                                    s.set_alpha_idx(s.alpha_idx() - base);
+                                    s
+                                })
+                                .collect(),
+                            alphas: self.storage.alphas[a0..].to_vec(),
+                        },
+                    ));
+                }
+            }
+            self.ranges.push(s0..self.storage.strips.len());
+        }
+    }
+}
+
+/// Parallel strip generation state owned by a `Scene`.
+#[derive(Debug)]
+pub(crate) struct ParallelStrips {
+    /// Worker count (1 = generate on the calling thread).
+    pub(crate) threads: usize,
+    /// Keep the previous frame's strips of unchanged paths.
+    pub(crate) cache_enabled: bool,
+    workers: Vec<Worker>,
+    cache: HashMap<u64, CachedStrips>,
+    /// Keys used since the last `end_frame`.
+    used: hashbrown::HashSet<u64>,
+    width: u16,
+    height: u16,
+    level: Level,
+    /// Cumulative cache statistics (hits, misses) since the last `take_stats`.
+    pub(crate) stats: (usize, usize),
+    /// Cumulative flush timing in ns: (parallel generate, ordered merge, record draws).
+    pub(crate) timing: [u64; 3],
+}
+
+/// Below this many jobs per chunk, threads cost more than they save.
+const MIN_JOBS_PER_CHUNK: usize = 32;
+
+impl ParallelStrips {
+    pub(crate) fn new(width: u16, height: u16, level: Level) -> Self {
+        Self {
+            threads: 1,
+            cache_enabled: false,
+            workers: Vec::new(),
+            cache: HashMap::new(),
+            used: hashbrown::HashSet::new(),
+            width,
+            height,
+            level,
+            stats: (0, 0),
+            timing: [0; 3],
+        }
+    }
+
+    pub(crate) fn resize(&mut self, width: u16, height: u16) {
+        if (width, height) != (self.width, self.height) {
+            self.width = width;
+            self.height = height;
+            self.workers.clear();
+            self.cache.clear();
+        }
+    }
+
+    /// Generate strips for `jobs` and append them to `out` in order. Returns
+    /// the strip range of each job within `out`.
+    pub(crate) fn generate(&mut self, jobs: &[PendingPath], out: &mut StripStorage) -> Vec<Range<usize>> {
+        let chunks = self.threads.max(1).min(jobs.len().div_ceil(MIN_JOBS_PER_CHUNK)).max(1);
+        while self.workers.len() < chunks {
+            self.workers.push(Worker::new(self.width, self.height, self.level));
+        }
+        // Cost-balanced contiguous split.
+        let total: usize = jobs.iter().map(PendingPath::cost).sum();
+        let mut bounds = Vec::with_capacity(chunks + 1);
+        bounds.push(0);
+        let mut acc = 0;
+        for (i, job) in jobs.iter().enumerate() {
+            acc += job.cost();
+            if bounds.len() < chunks && acc * chunks >= total * bounds.len() {
+                bounds.push(i + 1);
+            }
+        }
+        while bounds.len() <= chunks {
+            bounds.push(jobs.len());
+        }
+        #[cfg(feature = "multithreading")]
+        let t0 = std::time::Instant::now();
+        let cache = self.cache_enabled.then_some(&self.cache);
+        let (width, height) = (self.width, self.height);
+        let workers = &mut self.workers[..chunks];
+        #[cfg(feature = "multithreading")]
+        {
+            if chunks > 1 {
+                std::thread::scope(|scope| {
+                    let (first, rest) = workers.split_at_mut(1);
+                    for (i, worker) in rest.iter_mut().enumerate() {
+                        let range = bounds[i + 1]..bounds[i + 2];
+                        let jobs = &jobs[range];
+                        scope.spawn(move || worker.run(jobs, cache, width, height));
+                    }
+                    first[0].run(&jobs[bounds[0]..bounds[1]], cache, width, height);
+                });
+            } else {
+                workers[0].run(jobs, cache, width, height);
+            }
+        }
+        #[cfg(not(feature = "multithreading"))]
+        for (i, worker) in workers.iter_mut().enumerate() {
+            worker.run(&jobs[bounds[i]..bounds[i + 1]], cache, width, height);
+        }
+        #[cfg(feature = "multithreading")]
+        let t1 = std::time::Instant::now();
+        // Ordered merge.
+        let mut ranges = Vec::with_capacity(jobs.len());
+        for worker in self.workers[..chunks].iter() {
+            let strip_base = out.strips.len();
+            let alpha_base = out.alphas.len() as u32;
+            out.alphas.extend_from_slice(&worker.storage.alphas);
+            out.strips.extend(worker.storage.strips.iter().map(|s| {
+                let mut s = *s;
+                s.set_alpha_idx(s.alpha_idx() + alpha_base);
+                s
+            }));
+            ranges.extend(worker.ranges.iter().map(|r| r.start + strip_base..r.end + strip_base));
+        }
+        #[cfg(feature = "multithreading")]
+        {
+            self.timing[0] += (t1 - t0).as_nanos() as u64;
+            self.timing[1] += t1.elapsed().as_nanos() as u64;
+        }
+        if self.cache_enabled {
+            for worker in self.workers[..chunks].iter_mut() {
+                self.stats.0 += worker.hits.len();
+                self.stats.1 += worker.misses.len();
+                self.used.extend(worker.hits.iter().copied());
+                for (key, entry) in worker.misses.drain(..) {
+                    self.used.insert(key);
+                    self.cache.insert(key, entry);
+                }
+            }
+        }
+        ranges
+    }
+
+    /// Called once per frame (on `Scene::reset`): drop cache entries of paths
+    /// that were not drawn in the frame that just ended.
+    pub(crate) fn end_frame(&mut self) {
+        if self.cache_enabled {
+            let used = core::mem::take(&mut self.used);
+            self.cache.retain(|k, _| used.contains(k));
+        } else {
+            self.cache.clear();
+            self.used.clear();
+        }
+    }
+
+    pub(crate) fn cache_len(&self) -> usize {
+        self.cache.len()
+    }
+}
