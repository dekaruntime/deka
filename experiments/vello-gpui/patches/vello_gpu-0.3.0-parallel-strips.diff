+// Copyright 2025 the Vello Authors
+// SPDX-License-Identifier: Apache-2.0 OR MIT
+
+//! Fork (deka spike): deferred, parallel strip generation, an optional strip
+//! cache, and parallel copies for the render hand-off.
+//!
+//! `Scene` queues filled/stroked paths instead of generating strips
+//! immediately. A queued path is a [`PendingPath`] whose elements live in one
+//! flat, reused arena ([`Pending`]), so queueing allocates nothing in steady
+//! state and shapes are written into the arena straight from
+//! `Shape::path_elements` (no intermediate `BezPath`).
+//!
+//! At a flush point (any operation that touches the recorder or clip state,
+//! and before rendering) the queued batch is split into contiguous,
+//! cost-balanced chunks; each chunk is generated by its own `StripGenerator`
+//! into its own `StripStorage` on a persistent thread pool (with the
+//! `multithreading` feature), then the chunks are copied into the scene's
+//! storage in submission order (in parallel when large), offsetting each
+//! strip's alpha index. Strip generation is a pure function of (path,
+//! transform, fill/stroke, aliasing threshold, viewport), so the merged storage
+//! is byte-identical to sequential generation.
+//!
+//! The strip cache keys each job by a 64-bit hash of exactly those inputs and
+//! reuses the previous frame's strips for unchanged paths.
+//!
+//! [`Par`] lends the same pool to the renderer, which splits its large uploads
+//! (alphas, strips) into parallel copies.
+
+#![expect(
+    clippy::cast_possible_truncation,
+    reason = "alpha indices and arena ranges are u32 like vello_common's `Strip::alpha_idx`; \
+              nanosecond counters fit in u64"
+)]
+
+#[cfg(feature = "multithreading")]
+extern crate std;
+#[cfg(feature = "multithreading")]
+use alloc::sync::Arc;
+use alloc::vec::Vec;
+use core::marker::PhantomData;
+use core::ops::Range;
+use hashbrown::HashMap;
+use vello_common::fearless_simd::Level;
+use vello_common::kurbo::{Affine, Cap, Join, PathEl, Stroke};
+use vello_common::paint::Paint;
+use vello_common::peniko::Fill;
+use vello_common::strip::Strip;
+use vello_common::strip_generator::{GenerationMode, StripGenerator, StripStorage};
+
+/// Fill rule or stroke (index into [`Pending::strokes`]) of a queued path.
+#[derive(Debug, Clone, Copy)]
+pub(crate) enum Kind {
+    Fill(Fill),
+    Stroke(u32),
+}
+
+/// The style of a path being queued.
+pub(crate) enum Style<'a> {
+    Fill(Fill),
+    Stroke(&'a Stroke),
+}
+
+/// A path draw whose strips have not been generated yet.
+#[derive(Debug)]
+pub(crate) struct PendingPath {
+    kind: Kind,
+    /// Range of this path's elements in [`Pending::elements`].
+    elements: Range<u32>,
+    transform: Affine,
+    aliasing_threshold: Option<u8>,
+    pub(crate) paint: Paint,
+}
+
+/// Queued path draws. All storage is reused across flushes and frames.
+#[derive(Debug, Default)]
+pub(crate) struct Pending {
+    pub(crate) jobs: Vec<PendingPath>,
+    elements: Vec<PathEl>,
+    /// Distinct consecutive stroke styles (deduplicated against the last one).
+    strokes: Vec<Stroke>,
+}
+
+impl Pending {
+    pub(crate) fn is_empty(&self) -> bool {
+        self.jobs.is_empty()
+    }
+
+    pub(crate) fn clear(&mut self) {
+        self.jobs.clear();
+        self.elements.clear();
+        self.strokes.clear();
+    }
+
+    /// Queue a path draw, writing its elements into the arena.
+    pub(crate) fn push(
+        &mut self,
+        path: impl IntoIterator<Item = PathEl>,
+        style: Style<'_>,
+        transform: Affine,
+        aliasing_threshold: Option<u8>,
+        paint: Paint,
+    ) {
+        let start = self.elements.len() as u32;
+        self.elements.extend(path);
+        let kind = match style {
+            Style::Fill(fill) => Kind::Fill(fill),
+            Style::Stroke(stroke) => {
+                if self.strokes.last() != Some(stroke) {
+                    self.strokes.push(stroke.clone());
+                }
+                Kind::Stroke(self.strokes.len() as u32 - 1)
+            }
+        };
+        self.jobs.push(PendingPath {
+            kind,
+            elements: start..self.elements.len() as u32,
+            transform,
+            aliasing_threshold,
+            paint,
+        });
+    }
+
+    fn elements(&self, job: &PendingPath) -> &[PathEl] {
+        &self.elements[job.elements.start as usize..job.elements.end as usize]
+    }
+
+    /// Rough generation cost, used to balance chunks.
+    fn cost(&self, job: &PendingPath) -> usize {
+        let n = (job.elements.end - job.elements.start) as usize;
+        match job.kind {
+            Kind::Fill(_) => n + 4,
+            Kind::Stroke(s) => 2 * n + 4 + self.strokes[s as usize].dash_pattern.len(),
+        }
+    }
+
+    fn key(&self, job: &PendingPath, width: u16, height: u16) -> u64 {
+        let mut h = Hash64::default();
+        h.word(u64::from(width) << 16 | u64::from(height));
+        for c in job.transform.as_coeffs() {
+            h.f64(c);
+        }
+        h.word(job.aliasing_threshold.map_or(1 << 9, u64::from));
+        match job.kind {
+            Kind::Fill(fill) => h.word(match fill {
+                Fill::NonZero => 1,
+                Fill::EvenOdd => 2,
+            }),
+            Kind::Stroke(s) => {
+                let s = &self.strokes[s as usize];
+                h.word(3);
+                h.f64(s.width);
+                h.f64(s.miter_limit);
+                h.word(match s.join {
+                    Join::Bevel => 0,
+                    Join::Miter => 1,
+                    Join::Round => 2,
+                });
+                for cap in [s.start_cap, s.end_cap] {
+                    h.word(match cap {
+                        Cap::Butt => 0,
+                        Cap::Square => 1,
+                        Cap::Round => 2,
+                    });
+                }
+                h.f64(s.dash_offset);
+                for d in s.dash_pattern.iter() {
+                    h.f64(*d);
+                }
+            }
+        }
+        for el in self.elements(job) {
+            match *el {
+                PathEl::MoveTo(p) => {
+                    h.word(10);
+                    h.f64(p.x);
+                    h.f64(p.y);
+                }
+                PathEl::LineTo(p) => {
+                    h.word(11);
+                    h.f64(p.x);
+                    h.f64(p.y);
+                }
+                PathEl::QuadTo(a, b) => {
+                    h.word(12);
+                    for p in [a, b] {
+                        h.f64(p.x);
+                        h.f64(p.y);
+                    }
+                }
+                PathEl::CurveTo(a, b, c) => {
+                    h.word(13);
+                    for p in [a, b, c] {
+                        h.f64(p.x);
+                        h.f64(p.y);
+                    }
+                }
+                PathEl::ClosePath => h.word(14),
+            }
+        }
+        h.0
+    }
+}
+
+/// Small, fast 64-bit mixing hash (not cryptographic). A production version
+/// should use 128 bits or verify on hit; collisions here would reuse the wrong
+/// strips.
+#[derive(Default)]
+struct Hash64(u64);
+impl Hash64 {
+    #[inline(always)]
+    fn word(&mut self, w: u64) {
+        self.0 = (self.0 ^ w).wrapping_mul(0x9E37_79B9_7F4A_7C15).rotate_left(29);
+    }
+    #[inline(always)]
+    fn f64(&mut self, v: f64) {
+        self.word(v.to_bits());
+    }
+}
+
+/// Strips of one path with alpha indices rebased to 0.
+#[derive(Debug, Default)]
+struct CachedStrips {
+    strips: Vec<Strip>,
+    alphas: Vec<u8>,
+}
+
+#[derive(Debug)]
+struct Worker {
+    generator: StripGenerator,
+    storage: StripStorage,
+    /// Strip range (within `storage`) per job of this chunk.
+    ranges: Vec<Range<usize>>,
+    /// New cache entries produced by this chunk (key, strips).
+    misses: Vec<(u64, CachedStrips)>,
+    hits: Vec<u64>,
+}
+
+impl Worker {
+    fn new(width: u16, height: u16, level: Level) -> Self {
+        Self {
+            generator: StripGenerator::new(width, height, level),
+            storage: StripStorage::new(GenerationMode::Append),
+            ranges: Vec::new(),
+            misses: Vec::new(),
+            hits: Vec::new(),
+        }
+    }
+
+    fn run(
+        &mut self,
+        pending: &Pending,
+        jobs: Range<usize>,
+        cache: Option<&HashMap<u64, CachedStrips>>,
+        width: u16,
+        height: u16,
+    ) {
+        self.storage.clear();
+        self.ranges.clear();
+        self.misses.clear();
+        self.hits.clear();
+        for job in &pending.jobs[jobs] {
+            let s0 = self.storage.strips.len();
+            let a0 = self.storage.alphas.len();
+            let key = cache.map(|_| pending.key(job, width, height));
+            if let (Some(cache), Some(key)) = (cache, key)
+                && let Some(hit) = cache.get(&key)
+            {
+                let base = a0 as u32;
+                self.storage.alphas.extend_from_slice(&hit.alphas);
+                self.storage.strips.extend(hit.strips.iter().map(|s| {
+                    let mut s = *s;
+                    s.set_alpha_idx(s.alpha_idx() + base);
+                    s
+                }));
+                self.hits.push(key);
+            } else {
+                let path = pending.elements(job).iter().copied();
+                match job.kind {
+                    Kind::Fill(fill) => self.generator.generate_filled_path(
+                        path,
+                        fill,
+                        job.transform,
+                        job.aliasing_threshold,
+                        &mut self.storage,
+                        None,
+                    ),
+                    Kind::Stroke(s) => self.generator.generate_stroked_path(
+                        path,
+                        &pending.strokes[s as usize],
+                        job.transform,
+                        job.aliasing_threshold,
+                        &mut self.storage,
+                        None,
+                    ),
+                }
+                if let Some(key) = key {
+                    let base = a0 as u32;
+                    self.misses.push((
+                        key,
+                        CachedStrips {
+                            strips: self.storage.strips[s0..]
+                                .iter()
+                                .map(|s| {
+                                    let mut s = *s;
+                                    s.set_alpha_idx(s.alpha_idx() - base);
+                                    s
+                                })
+                                .collect(),
+                            alphas: self.storage.alphas[a0..].to_vec(),
+                        },
+                    ));
+                }
+            }
+            self.ranges.push(s0..self.storage.strips.len());
+        }
+    }
+}
+
+/// Below this much work per chunk (in [`Pending::cost`] units, roughly path
+/// elements; a small circle is ~10), a thread costs more than it saves.
+/// Measured on an i9-10910 with graph scenes: 75 paths (cost 850) went from
+/// 0.62 ms on the calling thread to 0.42 ms in 3 chunks; 30 paths (cost 340)
+/// gained nothing.
+const MIN_COST_PER_CHUNK: usize = 256;
+
+/// Chunks per pool thread (work stealing evens out mis-estimated chunks).
+const CHUNKS_PER_THREAD: usize = 4;
+
+/// Below this many bytes per thread, a parallel copy costs more than it saves
+/// (measured on an i9-10910 and an M1: a pool round trip is ~10-20 us, one
+/// core copies ~5-10 GB/s).
+#[cfg(feature = "multithreading")]
+const MIN_PARALLEL_COPY_BYTES: usize = 512 * 1024;
+
+/// A borrowed handle to the scene's worker pool (serial when there is none).
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct Par<'a> {
+    #[cfg(feature = "multithreading")]
+    pool: Option<&'a rayon::ThreadPool>,
+    _lifetime: PhantomData<&'a ()>,
+}
+
+impl Par<'_> {
+    /// No pool: everything on the calling thread.
+    pub(crate) fn serial() -> Par<'static> {
+        Par {
+            #[cfg(feature = "multithreading")]
+            pool: None,
+            _lifetime: PhantomData,
+        }
+    }
+
+    /// Number of pieces to split `bytes` of copying into.
+    fn pieces(&self, bytes: usize) -> usize {
+        #[cfg(feature = "multithreading")]
+        if let Some(pool) = self.pool {
+            return pool
+                .current_num_threads()
+                .min(bytes / MIN_PARALLEL_COPY_BYTES)
+                .max(1);
+        }
+        let _ = bytes;
+        1
+    }
+
+    /// Run `f(i)` for `i` in `0..n`, on the pool when there is one.
+    fn for_each<F: Fn(usize) + Sync>(&self, n: usize, f: F) {
+        #[cfg(feature = "multithreading")]
+        if let Some(pool) = self.pool
+            && n > 1
+        {
+            let f = &f;
+            pool.scope(|s| {
+                for i in 0..n {
+                    s.spawn(move |_| f(i));
+                }
+            });
+            return;
+        }
+        for i in 0..n {
+            f(i);
+        }
+    }
+
+    /// Copy `segments` back to back into `dst` (whose length is their total
+    /// length), split into parallel pieces when large.
+    #[cfg(feature = "wgpu")]
+    pub(crate) fn write(&self, dst: wgpu::WriteOnly<'_, [u8]>, segments: &[&[u8]]) {
+        let total = dst.len();
+        debug_assert_eq!(
+            total,
+            segments.iter().map(|s| s.len()).sum::<usize>(),
+            "destination must hold exactly the segments"
+        );
+        let pieces = self.pieces(total);
+        if pieces <= 1 {
+            write_range(dst, 0, segments);
+            return;
+        }
+        // Split the destination into `pieces` disjoint ranges.
+        let mut parts = Vec::with_capacity(pieces);
+        let mut rest = dst;
+        let mut start = 0;
+        for p in 1..pieces {
+            let end = total * p / pieces;
+            let (head, tail) = rest.split_at(end - start);
+            parts.push(core::cell::Cell::new(Some((SendWrite(head), start))));
+            rest = tail;
+            start = end;
+        }
+        parts.push(core::cell::Cell::new(Some((SendWrite(rest), start))));
+        let parts = SyncCells(parts);
+        self.for_each(pieces, |i| {
+            if let Some((dst, start)) = parts.take(i) {
+                write_range(dst.0, start, segments);
+            }
+        });
+    }
+}
+
+/// Copy the bytes `start..start + dst.len()` of the concatenation of
+/// `segments` into `dst`.
+#[cfg(feature = "wgpu")]
+fn write_range(mut dst: wgpu::WriteOnly<'_, [u8]>, start: usize, segments: &[&[u8]]) {
+    let end = start + dst.len();
+    let mut seg_start = 0;
+    let mut pos = 0;
+    for seg in segments {
+        let seg_end = seg_start + seg.len();
+        let lo = seg_start.max(start);
+        let hi = seg_end.min(end);
+        if lo < hi {
+            dst.slice(pos..pos + (hi - lo))
+                .copy_from_slice(&seg[lo - seg_start..hi - seg_start]);
+            pos += hi - lo;
+        }
+        seg_start = seg_end;
+        if seg_start >= end {
+            break;
+        }
+    }
+}
+
+/// A write-only mapped range moved to another thread.
+#[cfg(feature = "wgpu")]
+struct SendWrite<'a>(wgpu::WriteOnly<'a, [u8]>);
+// SAFETY: `WriteOnly<[u8]>` is an exclusive pointer to plain bytes, exactly
+// like `&mut [u8]` (which is `Send`). wgpu only lacks the impl because its
+// blanket `impl<T: Send> Send` requires `T: Sized`.
+#[cfg(feature = "wgpu")]
+unsafe impl Send for SendWrite<'_> {}
+
+/// Per-piece slots, each taken exactly once by the piece with that index.
+#[cfg(feature = "wgpu")]
+struct SyncCells<T>(Vec<core::cell::Cell<Option<T>>>);
+// SAFETY: piece `i` is the only task that touches slot `i` (`take(i)`), so no
+// slot is ever accessed from two threads; the payload itself is `Send`.
+#[cfg(feature = "wgpu")]
+unsafe impl<T: Send> Sync for SyncCells<T> {}
+#[cfg(feature = "wgpu")]
+impl<T> SyncCells<T> {
+    fn take(&self, i: usize) -> Option<T> {
+        self.0[i].take()
+    }
+}
+
+/// Parallel strip generation state owned by a `Scene`.
+#[derive(Debug)]
+pub(crate) struct ParallelStrips {
+    /// Worker count (1 = generate on the calling thread).
+    threads: usize,
+    #[cfg(feature = "multithreading")]
+    pool: Option<Arc<rayon::ThreadPool>>,
+    /// Keep the previous frame's strips of unchanged paths.
+    pub(crate) cache_enabled: bool,
+    workers: Vec<Worker>,
+    cache: HashMap<u64, CachedStrips>,
+    /// Keys used since the last `end_frame`.
+    used: hashbrown::HashSet<u64>,
+    width: u16,
+    height: u16,
+    level: Level,
+    /// Cumulative cache statistics (hits, misses) since the last `take_stats`.
+    pub(crate) stats: (usize, usize),
+    /// Cumulative flush timing in ns: (parallel generate, ordered merge, record draws).
+    pub(crate) timing: [u64; 3],
+}
+
+impl ParallelStrips {
+    pub(crate) fn new(width: u16, height: u16, level: Level) -> Self {
+        Self {
+            threads: 1,
+            #[cfg(feature = "multithreading")]
+            pool: None,
+            cache_enabled: false,
+            workers: Vec::new(),
+            cache: HashMap::new(),
+            used: hashbrown::HashSet::new(),
+            width,
+            height,
+            level,
+            stats: (0, 0),
+            timing: [0; 3],
+        }
+    }
+
+    pub(crate) fn threads(&self) -> usize {
+        self.threads
+    }
+
+    /// Use up to `threads` threads (a persistent pool; 1 = none).
+    pub(crate) fn set_threads(&mut self, threads: usize) {
+        let threads = threads.max(1);
+        if threads == self.threads {
+            return;
+        }
+        self.threads = 1;
+        #[cfg(feature = "multithreading")]
+        {
+            self.pool = None;
+            if threads > 1 {
+                match rayon::ThreadPoolBuilder::new()
+                    .num_threads(threads)
+                    .thread_name(|i| alloc::format!("vello-gpu-{i}"))
+                    .build()
+                {
+                    Ok(pool) => {
+                        self.pool = Some(Arc::new(pool));
+                        self.threads = threads;
+                    }
+                    Err(e) => log::warn!("vello_gpu: could not start {threads} threads ({e}); staying single-threaded"),
+                }
+            }
+        }
+    }
+
+    /// The pool, for the renderer's parallel copies.
+    pub(crate) fn par(&self) -> Par<'_> {
+        Par {
+            #[cfg(feature = "multithreading")]
+            pool: self.pool.as_deref(),
+            _lifetime: PhantomData,
+        }
+    }
+
+    pub(crate) fn resize(&mut self, width: u16, height: u16) {
+        if (width, height) != (self.width, self.height) {
+            self.width = width;
+            self.height = height;
+            self.workers.clear();
+            self.cache.clear();
+        }
+    }
+
+    /// Generate strips for the queued jobs and append them to `out` in order.
+    /// Returns the strip range of each job within `out`.
+    pub(crate) fn generate(&mut self, pending: &Pending, out: &mut StripStorage) -> Vec<Range<usize>> {
+        let jobs = &pending.jobs;
+        let total: usize = jobs.iter().map(|j| pending.cost(j)).sum();
+        // Split finer than the thread count so the pool can balance uneven
+        // chunks (cost is only an estimate of generation time).
+        let target = if self.threads > 1 { self.threads * CHUNKS_PER_THREAD } else { 1 };
+        let chunks = target.min(total / MIN_COST_PER_CHUNK).min(jobs.len()).max(1);
+        while self.workers.len() < chunks {
+            self.workers.push(Worker::new(self.width, self.height, self.level));
+        }
+        // Cost-balanced contiguous split.
+        let mut bounds = Vec::with_capacity(chunks + 1);
+        bounds.push(0);
+        let mut acc = 0;
+        for (i, job) in jobs.iter().enumerate() {
+            acc += pending.cost(job);
+            if bounds.len() < chunks && acc * chunks >= total * bounds.len() {
+                bounds.push(i + 1);
+            }
+        }
+        while bounds.len() <= chunks {
+            bounds.push(jobs.len());
+        }
+        #[cfg(feature = "multithreading")]
+        let t0 = std::time::Instant::now();
+        let cache = self.cache_enabled.then_some(&self.cache);
+        let (width, height) = (self.width, self.height);
+        let workers = &mut self.workers[..chunks];
+        #[cfg(feature = "multithreading")]
+        match self.pool.as_deref() {
+            Some(pool) if chunks > 1 => pool.scope(|s| {
+                for (i, worker) in workers.iter_mut().enumerate() {
+                    let range = bounds[i]..bounds[i + 1];
+                    s.spawn(move |_| worker.run(pending, range, cache, width, height));
+                }
+            }),
+            _ => {
+                for (i, worker) in workers.iter_mut().enumerate() {
+                    worker.run(pending, bounds[i]..bounds[i + 1], cache, width, height);
+                }
+            }
+        }
+        #[cfg(not(feature = "multithreading"))]
+        for (i, worker) in workers.iter_mut().enumerate() {
+            worker.run(pending, bounds[i]..bounds[i + 1], cache, width, height);
+        }
+        #[cfg(feature = "multithreading")]
+        let t1 = std::time::Instant::now();
+        let ranges = self.merge(chunks, out);
+        #[cfg(feature = "multithreading")]
+        {
+            self.timing[0] += (t1 - t0).as_nanos() as u64;
+            self.timing[1] += t1.elapsed().as_nanos() as u64;
+        }
+        if self.cache_enabled {
+            for worker in self.workers[..chunks].iter_mut() {
+                self.stats.0 += worker.hits.len();
+                self.stats.1 += worker.misses.len();
+                self.used.extend(worker.hits.iter().copied());
+                for (key, entry) in worker.misses.drain(..) {
+                    self.used.insert(key);
+                    self.cache.insert(key, entry);
+                }
+            }
+        }
+        ranges
+    }
+
+    /// Append the first `chunks` workers' strips and alphas to `out` in order,
+    /// rebasing alpha indices; in parallel when the copy is large.
+    fn merge(&mut self, chunks: usize, out: &mut StripStorage) -> Vec<Range<usize>> {
+        let workers = &self.workers[..chunks];
+        let strip_base0 = out.strips.len();
+        let alpha_base0 = out.alphas.len();
+        let mut ranges = Vec::with_capacity(workers.iter().map(|w| w.ranges.len()).sum());
+        // (strip base, alpha base) of each worker in `out`.
+        let mut bases = Vec::with_capacity(chunks);
+        let (mut sb, mut ab) = (strip_base0, alpha_base0);
+        for w in workers {
+            bases.push((sb, ab));
+            ranges.extend(w.ranges.iter().map(|r| r.start + sb..r.end + sb));
+            sb += w.storage.strips.len();
+            ab += w.storage.alphas.len();
+        }
+        let (n_strips, n_alphas) = (sb - strip_base0, ab - alpha_base0);
+        let bytes = n_strips * size_of::<Strip>() + n_alphas;
+        let par = self.par();
+        if chunks <= 1 || par.pieces(bytes) <= 1 {
+            for (w, &(_, ab)) in workers.iter().zip(&bases) {
+                out.alphas.extend_from_slice(&w.storage.alphas);
+                out.strips.extend(w.storage.strips.iter().map(|s| {
+                    let mut s = *s;
+                    s.set_alpha_idx(s.alpha_idx() + ab as u32);
+                    s
+                }));
+            }
+            return ranges;
+        }
+        out.strips.reserve(n_strips);
+        out.alphas.reserve(n_alphas);
+        {
+            // One disjoint destination per worker.
+            let mut strip_dst = &mut out.strips.spare_capacity_mut()[..n_strips];
+            let mut alpha_dst = &mut out.alphas.spare_capacity_mut()[..n_alphas];
+            let mut slots = Vec::with_capacity(chunks);
+            for w in workers {
+                let (s, srest) = strip_dst.split_at_mut(w.storage.strips.len());
+                let (a, arest) = alpha_dst.split_at_mut(w.storage.alphas.len());
+                strip_dst = srest;
+                alpha_dst = arest;
+                slots.push(core::cell::Cell::new(Some((s, a))));
+            }
+            let slots = MergeSlots(slots);
+            par.for_each(chunks, |i| {
+                let Some((strips, alphas)) = slots.take(i) else { return };
+                let w = &workers[i];
+                let ab = bases[i].1 as u32;
+                for (d, s) in alphas.iter_mut().zip(&w.storage.alphas) {
+                    d.write(*s);
+                }
+                for (d, s) in strips.iter_mut().zip(&w.storage.strips) {
+                    let mut s = *s;
+                    s.set_alpha_idx(s.alpha_idx() + ab);
+                    d.write(s);
+                }
+            });
+        }
+        // SAFETY: every element of the `n_strips` / `n_alphas` spare slots was
+        // written above (each worker's slice has exactly its storage's length,
+        // and the slices tile the reserved range); `for_each` returns only
+        // after all pieces have run.
+        unsafe {
+            out.strips.set_len(strip_base0 + n_strips);
+            out.alphas.set_len(alpha_base0 + n_alphas);
+        }
+        ranges
+    }
+
+    /// Called once per frame (on `Scene::reset`): drop cache entries of paths
+    /// that were not drawn in the frame that just ended.
+    pub(crate) fn end_frame(&mut self) {
+        if self.cache_enabled {
+            let used = core::mem::take(&mut self.used);
+            self.cache.retain(|k, _| used.contains(k));
+        } else {
+            self.cache.clear();
+            self.used.clear();
+        }
+    }
+
+    pub(crate) fn cache_len(&self) -> usize {
+        self.cache.len()
+    }
+}
+
+type MergeSlot<'a> = (&'a mut [core::mem::MaybeUninit<Strip>], &'a mut [core::mem::MaybeUninit<u8>]);
+
+/// Per-worker merge destinations, each taken exactly once by its worker index.
+struct MergeSlots<'a>(Vec<core::cell::Cell<Option<MergeSlot<'a>>>>);
+// SAFETY: task `i` is the only one that touches slot `i`, so no slot is
+// accessed from two threads; the payload (disjoint `&mut` slices) is `Send`.
+unsafe impl Sync for MergeSlots<'_> {}
+impl<'a> MergeSlots<'a> {
+    fn take(&self, i: usize) -> Option<MergeSlot<'a>> {
+        self.0[i].take()
+    }
+}
