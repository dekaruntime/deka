+
+thread_local! {
+    static CURRENT_CONTEXT: std::cell::RefCell<Option<WgpuContext>> = const { std::cell::RefCell::new(None) };
+}
+
+pub(crate) fn set_current_context(context: WgpuContext) {
+    CURRENT_CONTEXT.with(|c| *c.borrow_mut() = Some(context));
+}
+
+/// The wgpu context (instance, adapter, device, queue) GPUI's renderer uses on
+/// this thread, once a window has been created. Apps that render with wgpu
+/// themselves (e.g. vello) create their textures on this device and hand them
+/// to `Window::paint_external_texture`.
+pub fn current_context() -> Option<WgpuContext> {
+    CURRENT_CONTEXT.with(|c| c.borrow().clone())
+}
