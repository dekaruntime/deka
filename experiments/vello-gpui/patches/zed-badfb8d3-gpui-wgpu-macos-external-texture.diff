diff --git a/crates/gpui_macos/src/wgpu_renderer_glue.rs b/crates/gpui_macos/src/wgpu_renderer_glue.rs
new file mode 100644
index 0000000000..1b7ea87589
--- /dev/null
+++ b/crates/gpui_macos/src/wgpu_renderer_glue.rs
@@ -0,0 +1,133 @@
+//! Spike (deka): render a macOS GPUI window through `gpui_wgpu` (wgpu on its
+//! Metal backend) instead of `gpui_apple::metal_renderer`. Selected by the
+//! `wgpu` feature; exposes the same surface the window code calls.
+//!
+//! The window's backing layer is a CAMetalLayer we create here (so
+//! `makeBackingLayer` can return it), and the wgpu surface is built from that
+//! layer. Creating the surface from the NSView instead would make
+//! raw-window-metal call `setWantsLayer:` before the window state exists.
+
+use std::ffi::c_void;
+use std::sync::Arc;
+
+use gpui::{DevicePixels, Scene, Size};
+use gpui_wgpu::{WgpuAtlas, WgpuContext, WgpuRenderer, WgpuSurfaceConfig, wgpu};
+use foreign_types::ForeignType;
+use metal::{CAMetalLayer, MetalLayer, MetalLayerRef};
+use parking_lot::Mutex;
+
+/// One wgpu context (device + queue) shared by every window of the app.
+pub type Context = Arc<Mutex<Option<WgpuContext>>>;
+
+pub struct Renderer {
+    layer: MetalLayer,
+    inner: WgpuRenderer,
+}
+
+/// # Safety
+/// Called by the window code with valid native handles (unused here).
+pub unsafe fn new_renderer(
+    context: Context,
+    _native_window: *mut c_void,
+    _native_view: *mut c_void,
+    bounds: Size<f32>,
+    transparent: bool,
+) -> Renderer {
+    let layer = MetalLayer::new();
+    layer.set_opaque(!transparent);
+    layer.set_maximum_drawable_count(3);
+    let objc2_layer: &objc2_quartz_core::CAMetalLayer = unsafe { &*layer.as_ptr().cast() };
+    objc2_layer.setAllowsNextDrawableTimeout(false);
+    objc2_layer.setNeedsDisplayOnBoundsChange(true);
+    objc2_layer.setAutoresizingMask(
+        objc2_quartz_core::CAAutoresizingMask::LayerWidthSizable
+            | objc2_quartz_core::CAAutoresizingMask::LayerHeightSizable,
+    );
+
+    let mut shared = context.lock();
+    let instance = shared
+        .as_ref()
+        .map(|c| c.instance.clone())
+        .unwrap_or_else(|| WgpuContext::instance(None));
+    let surface = match unsafe {
+        instance.create_surface_unsafe(wgpu::SurfaceTargetUnsafe::CoreAnimationLayer(
+            layer.as_ptr() as *mut c_void,
+        ))
+    } {
+        Ok(surface) => surface,
+        Err(error) => fatal(&format!("wgpu surface from CAMetalLayer: {error}")),
+    };
+    let wgpu_context = match shared.as_ref() {
+        Some(c) => c.clone(),
+        None => match WgpuContext::new(instance, &surface, None) {
+            Ok(c) => {
+                *shared = Some(c.clone());
+                c
+            }
+            Err(error) => fatal(&format!("wgpu context: {error:#}")),
+        },
+    };
+    drop(shared);
+    let config = WgpuSurfaceConfig {
+        // Real drawable size arrives with the first update_drawable_size.
+        size: gpui::size(
+            DevicePixels(bounds.width.max(1.0) as i32),
+            DevicePixels(bounds.height.max(1.0) as i32),
+        ),
+        transparent,
+        preferred_present_mode: None,
+    };
+    let inner = match WgpuRenderer::new_from_surface(&wgpu_context, surface, config) {
+        Ok(r) => r,
+        Err(error) => fatal(&format!("wgpu renderer: {error:#}")),
+    };
+    Renderer { layer, inner }
+}
+
+/// Same policy as the Metal renderer: no usable GPU is fatal, but exit
+/// cleanly (a panic here would abort inside an Objective-C callback).
+fn fatal(message: &str) -> ! {
+    log::error!("{message}");
+    eprintln!("gpui_macos (wgpu): {message}");
+    std::process::exit(1);
+}
+
+impl Renderer {
+    pub fn layer(&self) -> Option<&MetalLayerRef> {
+        Some(&self.layer)
+    }
+
+    pub fn layer_ptr(&self) -> *mut CAMetalLayer {
+        self.layer.as_ptr()
+    }
+
+    pub fn sprite_atlas(&self) -> &Arc<WgpuAtlas> {
+        self.inner.sprite_atlas()
+    }
+
+    /// wgpu presents with `presentDrawable`; transactional presentation (used
+    /// by GPUI during live resize) is not wired up in this spike.
+    pub fn set_presents_with_transaction(&mut self, _presents_with_transaction: bool) {}
+
+    pub fn update_drawable_size(&mut self, size: Size<DevicePixels>) {
+        self.inner.update_drawable_size(size);
+    }
+
+    pub fn update_transparency(&mut self, transparent: bool) {
+        self.layer.set_opaque(!transparent);
+        self.inner.update_transparency(transparent);
+    }
+
+    pub fn destroy(&mut self) {
+        self.inner.destroy();
+    }
+
+    pub fn draw(&mut self, scene: &Scene) {
+        self.inner.draw(scene);
+    }
+
+    #[cfg(any(test, feature = "test-support"))]
+    pub fn render_to_image(&mut self, _scene: &Scene) -> anyhow::Result<image::RgbaImage> {
+        anyhow::bail!("render_to_image is not implemented for the wgpu spike renderer")
+    }
+}
