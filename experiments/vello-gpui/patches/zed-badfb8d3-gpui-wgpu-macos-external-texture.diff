+/// Spike (deka): wall time of each `renderer.draw(scene)` call in ms, drained
+/// by the caller. Used to compare GPUI's own frame cost on Metal vs wgpu.
+pub mod spike_draw_timings {
+    use std::sync::Mutex;
+    static TIMINGS: Mutex<Vec<f64>> = Mutex::new(Vec::new());
+    pub(crate) fn record(ms: f64) {
+        if let Ok(mut t) = TIMINGS.lock() {
+            t.push(ms);
+        }
+    }
+    /// Take all recorded draw timings (ms).
+    pub fn take() -> Vec<f64> {
+        TIMINGS.lock().map(|mut t| std::mem::take(&mut *t)).unwrap_or_default()
+    }
+}
 
