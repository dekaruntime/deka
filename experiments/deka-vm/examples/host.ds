import { print, sum, delay } from "vm:host";

fn makeCounter(start: number) {
    let count = start;
    return fn() number {
        count += 1;
        return count;
    };
}

async fn main() Promise<number> {
    const next = makeCounter(40);
    const pending = delay(30, "Rust timer completed");
    print("DekaScript continues while the Rust operation is pending");
    const message = await pending;
    print(message);
    return sum(next(), next());
}
