+
+/// deka comparison harness: read back the next presented frame (macOS only).
+pub mod readback {
+    use std::sync::atomic::AtomicBool;
+    /// Set before the window opens: the Metal layer's drawables become readable.
+    pub static ENABLED: AtomicBool = AtomicBool::new(false);
+    /// Set to copy the next drawn frame into [`RESULT`].
+    pub static REQUEST: AtomicBool = AtomicBool::new(false);
+    /// (width, height, RGBA rows) of the last requested frame.
+    pub static RESULT: parking_lot::Mutex<Option<(u32, u32, Vec<u8>)>> =
+        parking_lot::Mutex::new(None);
 }
