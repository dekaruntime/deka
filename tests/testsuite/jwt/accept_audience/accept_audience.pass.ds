import { sign, verify } from "jwt"
fn utf8(value: string): bytes {
  let encoded = unsafe { new TextEncoder().encode(value) }
  return match (encoded) {
    Ok(buf) => buf,
    Err(err) => utf8("")
  }
}
const token = match (sign({ sub: "1" }, utf8("secret"), { aud: "a" })) {
  Ok(v) => v,
  Err(e) => ""
}
console.log(match (verify(token, utf8("secret"), { aud: "a" })) {
  Ok(v) => "ok",
  Err(e) => "err"
})
