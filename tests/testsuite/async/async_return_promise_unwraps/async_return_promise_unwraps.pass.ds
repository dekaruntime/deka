import { echo } from "io"

async fn value() Promise<number> {
  return 1
}

async fn indirect() Promise<number> {
  let resolved = unsafe { Promise.resolve(2) }
  let pending = unwrap(resolved) or {
    0
  }
  return await pending
}

async fn main() {
  echo(string(await value()))
  echo(string(await indirect()))
}

await main()
