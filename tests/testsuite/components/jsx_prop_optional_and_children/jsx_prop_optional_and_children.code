interface CardProps {
  title: string;
  subtitle?: string;
}

interface LayoutProps {
  children: Component;
}

fn Card(props: CardProps) Component {
  return <h2>{props.title}</h2>
}

fn Layout(props: LayoutProps) Component {
  return <main>{props.children}</main>
}

const bare = <Card title={"Hello"} />
const full = <Card title={"Hello"} subtitle={"World"} />
const page = <Layout><Card title={"Hello"} /></Layout>
