import { write_file } from "fs"
fn utf8(value: string): bytes {
  let encoded = unsafe { new TextEncoder().encode(value) }
  return match (encoded) {
    Ok(buf) => buf,
    Err(err) => utf8("")
  }
}
async fn go() {
  const r = await write_file(".cache/missing-parent/x.txt", utf8("x"))
  console.log(match (r) { Ok(v) => "ok", Err(e) => "err" })
}
go()
