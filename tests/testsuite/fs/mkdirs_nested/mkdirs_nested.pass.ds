import { mkdirs, write_file, read_file } from "fs"
fn utf8(value: string): bytes {
  let encoded = unsafe { new TextEncoder().encode(value) }
  return match (encoded) {
    Ok(buf) => buf,
    Err(err) => utf8("")
  }
}
fn from_utf8(value: bytes): string {
  let decoded = unsafe { new TextDecoder("utf-8", { fatal: false }).decode(value) }
  return match (decoded) {
    Ok(text) => text,
    Err(err) => ""
  }
}
async fn go() {
  await mkdirs(".cache/a/b")
  await write_file(".cache/a/b/c.txt", utf8("z"))
  const r = await read_file(".cache/a/b/c.txt")
  console.log(match (r) { Ok(buf) => from_utf8(buf), Err(e) => "fail" })
}
go()
