interface Named {
  name: string
}
interface Greeter {
  fn greet(other: Named) string
}
struct Person {
  name: string
}
fn (p Person) greet(other: Named) string {
  return "Hello, " + other.name + " from " + p.name
}
fn run(g: Greeter) {
  console.log(g.greet(Person { name: "World" }))
}
run(Person { name: "Deka" })
