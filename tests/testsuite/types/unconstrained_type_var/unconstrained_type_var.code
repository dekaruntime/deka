import { echo } from "io"

fn ok_only() Result<string, string> {
  return Result.Ok("y")
}

fn err_only() Result<string, string> {
  return Result.Err("e")
}

fn none_only() Option<number> {
  return None
}

const empty: Array<string> = []

echo(match (ok_only()) {
  Ok(v) => v,
  Err(e) => e,
})
echo(match (err_only()) {
  Ok(v) => v,
  Err(e) => e,
})

let n = unwrap(none_only()) or {
  0
}
echo(string(n))
echo(string(empty.length))
