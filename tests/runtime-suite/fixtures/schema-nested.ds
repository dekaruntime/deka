const Address = globalThis.schema.struct({
  city: globalThis.schema.string,
});

const User = globalThis.schema.struct({
  name: globalThis.schema.string,
  address: Address,
});

const result = User.parse({ name: "Sami", address: { city: "Calgary" } });
console.log(result.ok);
console.log(result.value.address.city);
