const pair = createSignal(0);
const get = pair[0];
const set = pair[1];
console.log(get());
set(5);
console.log(get());

fn trackEffect() void {
  const v = get();
  console.log("effect");
}

createEffect(trackEffect);
set(10);

const pairA = createSignal(1);
const getA = pairA[0];
const setA = pairA[1];

fn computeMemo() number {
  console.log("computed");
  return getA() * 2;
}

const memoGet = createMemo(computeMemo);
console.log(memoGet());
console.log(memoGet());
setA(3);
console.log(memoGet());

const pairMulti = createSignal(0);
const getM = pairMulti[0];
const setM = pairMulti[1];

fn subA() void {
  console.log("A" + getM());
}

fn subB() void {
  console.log("B" + getM());
}

createEffect(subA);
createEffect(subB);
setM(1);

const pairClean = createSignal(0);
const getC = pairClean[0];
const setC = pairClean[1];

const cleanupRunsPair = createSignal(0);
const getCleanupRuns = cleanupRunsPair[0];
const setCleanupRuns = cleanupRunsPair[1];

fn runCleanup() void {
  setCleanupRuns(getCleanupRuns() + 1);
}

fn withCleanup() fn() void {
  const v = getC();
  return runCleanup;
}

createEffect(withCleanup);
setC(1);
setC(2);
console.log(getCleanupRuns());
