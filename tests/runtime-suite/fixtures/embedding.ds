struct Person {
  name: string
}

fn (p Person) greet() string {
  return "Hello, " + p.name;
}

struct Employee {
  Person
  employeeId: string
}

fn (e Employee) greet() string {
  return "Employee " + e.employeeId;
}

let e = Employee {
  Person: Person { name: "Charlie" },
  employeeId: "E54321"
};

console.log(e.greet());
