const ui = globalThis.deka.ui;

struct ErrorInfo {
  message: string
}

async fn Bad(): Promise<object> {
  return Result.Err(ErrorInfo { message: "boom" });
}

const node = ui.jsx(ui.ErrorBoundary, {
  fallback: fn(err: ErrorInfo) { return ui.jsx("p", { children: err.message }); },
  children: ui.jsx(Bad, {})
});

async fn main(): Promise<void> {
  const result = await ui.renderToStringAsync(node);
  console.log(result.html);
}

main();
