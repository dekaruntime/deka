import { echo } from "io"

fn label(o: Option<string>) string {
  let v = unwrap(o) or {
    "fallback"
  }
  return v
}

fn early(o: Option<string>) string {
  let v = unwrap(o) or {
    return "exited"
  }
  return "got " + v
}

fn attempt() Result<string, string> {
  return Result.Ok("y")
}

fn tried() string {
  let v = unwrap(attempt()) or {
    "no"
  }
  return v
}

fn described(r: Result<string, string>) string {
  let v = unwrap(r) or match {
    Err(message) => "failed: " + message,
  }

  return v
}

echo(label(Option.Some("a")))
echo(label(None))
echo(early(None))
echo(tried())
echo(described(Result.Err("boom")))
