import { echo } from "io"

// Enums describe a fixed set of cases. Unlike the language's
// containers, user enums do not take type parameters — each case
// carries concrete payloads instead (deka#561).
enum Box {
  Empty,
  Full(number),
}

// Match on the cases to read the payload back out.
fn size(b: Box) number {
  return match (b) {
    Full(value) => value,
    Empty => 0,
  }
}

echo(string(size(Box.Full(5))))
echo(string(size(Box.Empty)))

// Cases without payloads work too — this is the plain choice when
// the variants carry no data.
enum State {
  Draft,
  Published,
  Archived,
}

fn label(s: State) string {
  return match (s) {
    Draft => "work in progress",
    Published => "live",
    Archived => "on the shelf",
  }
}

echo(label(State.Draft))
echo(label(State.Archived))
