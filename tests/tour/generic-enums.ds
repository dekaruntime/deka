import { echo } from "io"

enum Box<T> {
  Empty,
  Full(T),
}

fn size(b: Box<number>) number {
  return match (b) {
    Full(value) => value,
    Empty => 0,
  }
}

echo(string(size(Box.Full(5))))
echo(string(size(Box.Empty)))

enum Either<A, B> {
  Left(A),
  Right(B),
}

fn describe(e: Either<number, string>) string {
  return match (e) {
    Left(n) => string(n),
    Right(s) => s,
  }
}

echo(describe(Either.Left(1)))
echo(describe(Either.Right("two")))
