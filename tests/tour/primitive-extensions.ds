import { echo } from "io"

// Extensions add methods to primitive types. Name the receiver type in
// parens before the method name — the compiler dispatches them as plain
// functions, so nothing is attached to JS prototypes.
fn (s string) shout() string {
  return s.toUpperCase() + "!"
}

fn (n number) squared() number {
  return n * n
}

// Call them exactly like builtin methods, on variables or literals.
const message = "hello deka"
echo(message.shout())

// Extensions return the receiver's type, so they chain.
const side = 7
echo(string(side.squared()))
echo(string(side.squared().squared()))
