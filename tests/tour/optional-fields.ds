import { echo } from "io"

struct User {
  name: string;
  email?: string;
}

interface Profile {
  nickname?: string;
}

const user = User { name: "DekaScript", email: None }

const contact = match (user.email) {
  Some(value) => value,
  None => "no email",
}

fn greet(profile: Profile) string {
  return match (profile.nickname) {
    Some(name) => name,
    None => "friend",
  }
}

echo(contact)
echo(greet({nickname: None}))
echo(greet({nickname: Option.Some("Deka")}))
