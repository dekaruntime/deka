interface CardProps {
  title: string;
  subtitle?: string;
}

interface LayoutProps {
  children: Component;
}

fn Card(props: CardProps) Component {
  const sub = match (props.subtitle) {
    Some(s) => <p>{s}</p>,
    None => <></>,
  }

  return <article>
<h2>{props.title}</h2>
{sub}
</article>
}

fn Layout(props: LayoutProps) Component {
  return <main>{props.children}</main>
}

const bare = <Card title={"Hello"} />
const full = <Card title={"Hello"} subtitle={"DekaScript"} />
const page = <Layout><Card title={"Hello"} /></Layout>
