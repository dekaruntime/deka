import { echo } from "io"

// `super` marks a declaration whose type information survives to
// runtime. A plain struct is compile-time only; a super struct carries
// a descriptor you reach from the type itself.
super struct User {
  id: number;
  name: string;
}

super enum Status {
  Active,
  Archived,
}

// `.type()` on the declaration names the type, so the compiler builds
// the descriptor for you — a frozen value, emitted where you use it,
// never a global.
const t = User.type()
echo(t.toString())

// Composition does not repeat the mark: every type a super declaration
// references is described too, even when written plain.
struct Address {
  city: string;
}

super struct Order {
  id: number;
  ship_to: Address;
}

echo(Order.type().toString())

// For the runtime type of a value, ask the value: value.getType().
// Name.type() names the declaration; getType() inspects what you
// actually hold. (See "type values and getType".)
const u = User { id: 1, name: "Deka" }
echo(u.getType().toString())

// Recursive types work — the descriptor resolves its own fields
// lazily, so a struct can mention itself.
super struct Node {
  next: Option<Node>;
}

echo(Node.type().toString())
