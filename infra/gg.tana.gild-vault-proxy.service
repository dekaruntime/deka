[Unit]
Description=Tana Gild Vault HTTP proxy
After=network-online.target gg.tana.gild-vault.service
Wants=network-online.target

[Service]
Type=simple
User=gild-vault-proxy
# The deployed vault socket is 0660 root:gild at /run/gild-vault/sock.
SupplementaryGroups=gild
Environment=VAULT_PROXY_TOKEN_FILE=/etc/gild/vault-proxy-token
Environment=VAULT_SOCKET=/run/gild-vault/sock
ExecStart=/usr/local/bin/gild-vault-proxy --bind 0.0.0.0:9444
Restart=on-failure
RestartSec=2s

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
ReadOnlyPaths=/etc/gild/vault-proxy-token /etc/gild/vault-proxy-ca.pem /etc/gild/vault-proxy.pem /etc/gild/vault-proxy.key /run/gild-vault/sock
ReadWritePaths=/var/log/gild-vault-proxy-audit.log

[Install]
WantedBy=multi-user.target
