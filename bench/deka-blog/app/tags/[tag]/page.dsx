import { tagParams } from "../../../src/posts.generated.ds"
import { TagPage } from "../../../src/ui/TagPage.dsx"
import { Title } from "../../../src/ui/Title.dsx"

interface PageProps {
  tag: string
}
struct TagParam {
  tag: string
}

export const staticParams: Array<TagParam> = build {
  return Ok(tagParams)
}

export fn head() ReactNode {
  return Title("Tag · Signal Path")
}

export fn Page(props: PageProps) ReactNode {
  return TagPage(props.tag)
}
