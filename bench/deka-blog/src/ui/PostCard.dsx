import { TagList } from "./TagList.dsx"

interface PostCardProps {
  slug: string
  title: string
  date: string
  excerpt: string
  tags: Array<string>
}

export fn PostCard(props: PostCardProps) ReactNode {
  return <a class="card" href={"/posts/" + props.slug}>
      <span data-bench-edit="card">Read post</span>
      <h2>{props.title}</h2>
      <div class="meta">{props.date}</div>
      <p>{props.excerpt}</p>
      <TagList tags={props.tags} />
    </a>
}
