export fn AboutPage() ReactNode {
  return <article class="prose">
      <h1 class="page-title">About this blog</h1>
      <p>Signal Path is the subject app for the deka-bench comparison: one blog, identical markdown, implemented in deka, Vite + React, and Next.js App Router.</p>
      <p>The chrome is static. The theme toggle and the newsletter form are the only islands. Everything else is HTML the compiler already knew.</p>
      <p>Fair play is the product. Versions are pinned, the runner is one command, and empty cells in the results table stay empty until the owning lane fills them.</p>
    </article>
}
