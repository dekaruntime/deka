import { jsx as _boot } from "./index.ds"
import { stateImpl, effectImpl, refImpl, createContextImpl, contextImpl } from "./index.ds"

opaque type Any

fn memoImpl(compute: Any, _deps: Any) Any {
  const result = unsafe { return compute() }
  return match (result) {
    Ok(v) => v,
    Err(_) => compute
  }
}
fn callbackImpl(fnVal: Any, _deps: Any) Any {
  return fnVal
}

export { stateImpl as useState }
export { effectImpl as useEffect }
export { refImpl as useRef }
export { createContextImpl as createContext }
export { contextImpl as useContext }
export { memoImpl as useMemo }
export { callbackImpl as useCallback }

const _keep = _boot
