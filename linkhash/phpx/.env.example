# Postgres (required for auth, publish, install)
DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=linkhash_registry
DB_USER=postgres
DB_PASSWORD=postgres

# Port (default 8530; set to 4004 for linkha.sh standalone)
PORT=4004

# Git API backend (deka-git / tana git-server)
LINKHASH_GIT_API_URL=http://127.0.0.1:8508
LINKHASH_GIT_TOKEN=

# Log backend: db (postgres) or file
LINKHASH_LOG_BACKEND=db

# Artifact storage backend: local (inline postgres) or r2
LINKHASH_ARTIFACT_BACKEND=local

# R2 artifact storage (optional, only needed when LINKHASH_ARTIFACT_BACKEND=r2)
LINKHASH_R2_ACCOUNT_ID=
LINKHASH_R2_BUCKET=
LINKHASH_R2_ACCESS_KEY_ID=
LINKHASH_R2_SECRET_ACCESS_KEY=
LINKHASH_R2_REGION=auto
LINKHASH_R2_ENDPOINT=

# Adwa preview/editor integration (optional)
LINKHASH_ADWA_BASE_URL=http://localhost:8600

# Bluesky OAuth
LINKHASH_OAUTH_CLIENT_ID=
LINKHASH_OAUTH_CLIENT_SECRET=
LINKHASH_OAUTH_CALLBACK=http://localhost:4004/api/auth/callback
LINKHASH_OAUTH_AUTH_URL=https://bsky.social/oauth/authorize
LINKHASH_OAUTH_TOKEN_URL=https://bsky.social/oauth/token
LINKHASH_OAUTH_PROFILE_URL=https://bsky.social/xrpc/com.atproto.server.getSession
LINKHASH_OAUTH_SCOPE=atproto transition:generic
LINKHASH_OAUTH_CALLBACK_ALLOWLIST=http://localhost:4004/api/auth/callback
