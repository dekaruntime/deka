  $repo = normalizePackageName($name)
  $file = ltrim(trim('' . $path), '/')
  if ($repo === '' || $file === '') {
    return [ 'ok' => false, 'error' => 'invalid blob target', 'status' => 404 ]
  }
  $res = httpRequestRaw('GET', linkhashGitApiBase() . publicDekaRepoBlobPath($repo, $file), [ 'Accept' => 'application/json' ], '')
  if (!rowValue($res, 'ok', false)) {
    return [ 'ok' => false, 'error' => 'blob request failed', 'status' => 502 ]
  }
  $status = (int) rowValue($res, 'status', 0)
  if ($status < 200 || $status >= 300) {
    return [ 'ok' => false, 'error' => $status === 404 ? 'file not found' : 'blob not available', 'status' => $status ]
  }
  $decoded = decodeJsonLike(rowValue($res, 'body', '{}'), null)
  if (!is_array($decoded)) {
    return [ 'ok' => false, 'error' => 'invalid blob payload', 'status' => 502 ]
  }
  return [ 'ok' => true, 'value' => $decoded ]
}

function publicReadmePath($entries) {
  if (!is_array($entries)) {
    return ''
  }
  foreach ($entries as $entry) {
    $path = '' . rowValue($entry, 'path', '')
    $kind = '' . rowValue($entry, 'kind', rowValue($entry, 'type', 'blob'))
    if (($kind === 'blob' || $kind === 'file') && (strtolower($path) === 'readme' || strtolower($path) === 'readme.md')) {
      return $path
    }
  }
  return ''
}

function linkhashGitAuthToken() {
  $token = trim('' . envValue('LINKHASH_GIT_TOKEN', ''))
  if ($token !== '') {
    return $token
  }
  return trim('' . envValue('LINKHASH_GIT_API_TOKEN', ''))
}

function linkhashGitAuthHeaders($extra = []) {
  $headers = is_array($extra) ? $extra : []
  $headers['Accept'] = 'application/json'
  $token = linkhashGitAuthToken()
  if ($token !== '') {
    $headers['Authorization'] = 'Bearer ' . $token
  }
  return $headers
}

function fetchRemoteGitJson($method, $path, $payload = null) {
  $url = linkhashGitApiBase() . $path
  $body = ''
  $headers = linkhashGitAuthHeaders([])
  if (isset($payload)) {
    $encoded = encodeJson(normalizeJsonValue($payload))
    if (!is_string($encoded)) {
      return [ 'ok' => false, 'error' => 'json encode failed' ]
    }
    $body = $encoded
    $headers['Content-Type'] = 'application/json'
  }
  $res = httpRequestRaw($method, $url, $headers, $body)
  if (!rowValue($res, 'ok', false)) {
    $rawErr = '' . rowValue($res, 'error', 'request failed')
    return [ 'ok' => false, 'error' => 'request failed (' . $rawErr . ')', 'url' => $url ]
  }
  $status = (int) rowValue($res, 'status', 0)
  $decoded = decodeJsonLike(rowValue($res, 'body', '{}'), null)
  if (!is_array($decoded)) {
    return [ 'ok' => false, 'error' => 'invalid response payload', 'status' => $status ]
  }
  if ($status < 200 || $status >= 300) {
    return [ 'ok' => false, 'error' => '' . rowValue($decoded, 'error', 'request rejected'), 'status' => $status, 'payload' => $decoded ]
  }
  return [ 'ok' => true, 'value' => $decoded, 'status' => $status ]
}

function fetchRemoteDeployWatchers() {
  return fetchRemoteGitJson('GET', '/api/deploy-watchers')
}

/*
 * Registry reads. These replace the package/package_version/org tables that
 * linkha.sh used to mirror in its own Postgres; the git server owns this data.
 */
function fetchRegistryPackageRows() {
  $res = fetchRemoteGitJson('GET', registryPackagesPath())
  if (!rowValue($res, 'ok', false)) {
    return [ 'ok' => false, 'error' => '' . rowValue($res, 'error', 'registry unavailable'), 'status' => (int) rowValue($res, 'status', 502) ]
  }
  $payload = rowValue($res, 'value', [])
  $entries = rowValue($payload, 'packages', null)
  if (!is_array($entries)) {
    return [ 'ok' => false, 'error' => 'invalid registry payload', 'status' => 502 ]
  }
  return [ 'ok' => true, 'rows' => registryRowsFromApi($entries) ]
}

