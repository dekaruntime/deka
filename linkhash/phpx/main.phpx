function fetchPublicDekaRepoTree($name) {
  $repo = normalizePackageName($name)
  if ($repo === '') {
    return [ 'ok' => false, 'error' => 'invalid repository target', 'status' => 404 ]
  }
  $res = httpRequestRaw('GET', linkhashGitApiBase() . publicDekaRepoTreePath($repo), [ 'Accept' => 'application/json' ], '')
  if (!rowValue($res, 'ok', false)) {
    return [ 'ok' => false, 'error' => 'tree request failed', 'status' => 502 ]
  }
  $status = (int) rowValue($res, 'status', 0)
  if ($status < 200 || $status >= 300) {
    return [ 'ok' => false, 'error' => $status === 404 ? 'package not found' : 'tree not available', 'status' => $status ]
  }
  $decoded = decodeJsonLike(rowValue($res, 'body', '{}'), null)
  if (!is_array($decoded)) {
    return [ 'ok' => false, 'error' => 'invalid tree payload', 'status' => 502 ]
  }
  return [ 'ok' => true, 'value' => $decoded ]
}

