{
  "name": "@tana-admin/linkhash",
  "version": "0.1.0",
  "description": "linkha.sh — PHPX package registry web UI",
  "serve": {
    "entry": "main_online.phpx",
    "mode": "php"
  },
  "scripts": {
    "dev": "deka serve --dev"
  },
  "security": {
    "allow": {
      "db": ["postgres", "sqlite"],
      "net": ["127.0.0.1:8508", "localhost:8508", "*"],
      "read": ["*"],
      "dynamic": true,
      "run": ["git"]
    }
  }
}
